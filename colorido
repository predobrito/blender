def caminhao(nome, basculante=False):
    m = Malha(nome)
    L, W = 6.2, 2.3
    m.box((0, 0, 0.8), (L, 1.0, 0.25))                                  # chassi
    m.box((2.0, 0, 1.55), (1.7, W - 0.1, 1.5))                          # cabine
    m.box((2.0, 0, 2.35), (1.8, W - 0.05, 0.09))
    m.box((3.1, 0, 1.2), (1.0, W - 0.2, 0.9))                           # capo
    m.box((3.65, 0, 1.2), (0.12, W - 0.5, 0.65))
    for sy in (-1, 1):
        m.box((2.3, sy * (W / 2.0 - 0.02), 1.85), (0.9, 0.04, 0.55))
        m.box((1.2, sy * (W / 2.0 - 0.02), 1.0), (0.06, 0.06, 0.5))
        m.box((2.9, sy * (W / 2.0 + 0.05), 0.6), (0.9, 0.2, 0.06))
        far(m, (3.72, sy * 0.7, 1.2), (1, 0, 0), 0.1)
        m.cil((-0.6, sy * 1.05, 0.62), 0.28, 0.9, (1, 0, 0), seg=12)       # tanque
        m.box((3.8, sy * 0.9, 0.55), (0.2, 0.5, 0.12))
    m.box((3.85, 0, 0.5), (0.2, W + 0.1, 0.2))
    if not basculante:
        m.box((-1.15, 0, 1.0), (3.6, W, 0.15))                           # carroceria
        for sy in (-1, 1):
            m.box((-1.15, sy * (W / 2.0 - 0.04), 1.5), (3.6, 0.08, 0.9), rx=sy * 0.04)
        m.box((-2.9, 0, 1.45), (0.08, W, 0.8), rx=0.0)
        m.box((0.6, 0, 1.45), (0.08, W, 0.8))
        for k in range(6):
            m.box((-2.8 + k * 0.62, 0, 1.15), (0.1, W + 0.04, 0.06))
        m.box((-1.15, 0.0, 1.14), (3.4, 0.08, 0.04))
    else:
        m.push(Matrix.Translation((-2.6, 0, 1.0)) @ Matrix.Rotation(-0.32, 4, 'Y'))
        m.box((1.7, 0, 0.1), (3.6, W - 0.1, 0.12))
        for sy in (-1, 1):
            m.box((1.7, sy * (W / 2.0 - 0.1), 0.65), (3.6, 0.1, 1.1))
        m.box((3.4, 0, 0.7), (0.1, W - 0.2, 1.2))
        m.box((0.0, 0, 0.7), (0.1, W - 0.2, 1.2))
        m.pop()
        m.tubo((-0.4, 0, 0.9), (-1.4, 0, 1.9), 0.09, 8)
        m.tubo((-0.4, 0, 0.9), (-0.9, 0, 1.4), 0.12, 8)
    for (x, sy) in ((2.3, 1), (2.3, -1), (-0.9, 1), (-0.9, -1), (-2.2, 1), (-2.2, -1)):
        roda(m, (x, sy * (W / 2.0 - 0.16), 0.5), 0.5, 0.3, 1.0 if not (x == -2.2 and sy < 0) else 0.8, True)
    return m.mesh("veic_dump" if basculante else "veic_truck", 0.015)


def onibus(nome):
    m = Malha(nome)
    L, W, H = 11.0, 2.5, 3.0
    m.box((0, 0, 0.9), (L, W, 1.0))                                     # saia
    m.box((0, 0, H - 0.1), (L, W - 0.05, 0.2))                          # teto
    for sy in (-1, 1):
        for i in range(11):
            x = -L / 2.0 + 0.25 + i * (L - 0.5) / 10.0
            m.box((x, sy * (W / 2.0 - 0.05), 2.0), (0.1, 0.1, 1.2))      # pilares das janelas
            if (i == 6 and sy == 1):
                continue
        m.box((0, sy * (W / 2.0 - 0.05), 2.6), (L, 0.1, 0.1))
        m.box((0, sy * (W / 2.0 - 0.05), 1.5), (L, 0.1, 0.12))
        for k in range(3):                                              # vidros estilhacados
            m.box((-3.0 + k * 2.5, sy * (W / 2.0 - 0.05), 1.9), (0.5, 0.02, 0.35), rx=0.4)
    m.box((L / 2.0 - 0.04, 0, 1.9), (0.08, W - 0.1, 1.6))               # frente
    m.box((L / 2.0 + 0.02, 0, 0.75), (0.1, W, 0.2))
    m.box((-L / 2.0 + 0.04, 0, 1.9), (0.08, W - 0.1, 1.6))
    for sy in (-1, 1):
        far(m, (L / 2.0 + 0.05, sy * 0.8, 0.9), (1, 0, 0), 0.12)
    for x in (-2.5, 0.3):
        m.box((x, 0, H + 0.05), (1.4, 1.0, 0.1))
    m.box((3.0, W / 2.0 + 0.05, 1.3), (0.9, 0.06, 2.0), yaw=0.0)         # porta
    m.box((3.5, W / 2.0 + 0.45, 1.3), (0.9, 0.06, 2.0), yaw=0.9)
    # bancos visiveis
    for i in range(6):
        for sy in (-0.6, 0.6):
            m.box((-4.0 + i * 1.4, sy, 1.0), (0.45, 0.45, 0.5))
            m.box((-4.2 + i * 1.4, sy, 1.35), (0.08, 0.45, 0.6))
    for (x, sy) in ((3.7, 1), (3.7, -1), (-3.2, 1), (-3.2, -1)):
        roda(m, (x, sy * (W / 2.0 - 0.14), 0.5), 0.5, 0.3, 0.7 if (x < 0 and sy < 0) else 1.0, True)
    return m.mesh("veic_bus", 0.015)


def trator(nome):
    m = Malha(nome)
    m.box((0.3, 0, 1.0), (2.4, 0.9, 0.5))
    m.box((1.1, 0, 1.3), (1.3, 0.9, 0.7))
    m.box((1.8, 0, 1.2), (0.15, 0.8, 0.5))
    m.cil((1.5, 0.3, 2.05), 0.06, 1.0, seg=8)
    m.cil((1.5, 0.3, 2.6), 0.1, 0.1, seg=8)
