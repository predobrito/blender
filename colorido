def trifolio(m, c, r):
    """Simbolo de radiacao em relevo (plano XZ, voltado para -Y)."""
    cx, cy, cz = c
    m.cil((cx, cy - 0.01, cz), r * 0.16, 0.02, (0, 1, 0), seg=14)
    for k in range(3):
        a0 = pi / 2 + k * 2 * pi / 3 - pi / 6
        pts = [(cx, cz)]
        for s in range(7):
            a = a0 + s * (pi / 3) / 6
            pts.append((cx + r * 0.85 * cos(a), cz + r * 0.85 * sin(a)))
        pts[0] = (cx + r * 0.22 * cos(a0 + pi / 6), cz + r * 0.22 * sin(a0 + pi / 6))
        pts = [(cx + (p[0] - cx), cz + (p[1] - cz)) for p in pts]
        m.prisma(pts, cy - 0.03, cy - 0.005, 'XZ')


def malhas_placas():
    P = {}
    # circular com borda (tipo proibicao), triangular, retangular, octogonal, radiacao
    def poste(m, h):
        m.cil((0, 0, h / 2), 0.045, h, seg=8)
        m.cil((0, 0, 0.04), 0.09, 0.08, seg=8)
    m = Malha("Placa_Redonda"); poste(m, 2.8)
    m.cil((0, -0.07, 2.4), 0.35, 0.03, (0, 1, 0), seg=24); m.toro((0, -0.09, 2.4), 0.30, 0.02, (0, 1, 0), 24, 5)
    m.box((0.0, -0.1, 2.4), (0.45, 0.01, 0.08), ry=0.7)
    P["redonda"] = m.mesh("sinal", 0.004)
    m = Malha("Placa_Triangular"); poste(m, 2.8)
    m.prisma([(-0.4, 2.1), (0.4, 2.1), (0, 2.8)], -0.085, -0.055, 'XZ')
    m.prisma([(-0.28, 2.18), (0.28, 2.18), (0, 2.62)], -0.095, -0.085, 'XZ')
    P["triangular"] = m.mesh("sinal", 0.004)
    m = Malha("Placa_Retangular"); poste(m, 2.6)
    m.box((0, -0.07, 2.2), (0.8, 0.03, 0.55)); m.box((0, -0.09, 2.2), (0.7, 0.01, 0.45))
    P["retangular"] = m.mesh("sinal", 0.004)
    m = Malha("Placa_Parada")
    poste(m, 2.8)
    pts = [(0.35 * cos(pi / 8 + k * pi / 4), 2.45 + 0.35 * sin(pi / 8 + k * pi / 4)) for k in range(8)]
    m.prisma(pts, -0.085, -0.055, 'XZ')
    P["octogonal"] = m.mesh("sinal", 0.004)
    m = Malha("Placa_Radiacao"); poste(m, 2.5)
    m.prisma([(-0.45, 1.95), (0.45, 1.95), (0, 2.75)], -0.085, -0.055, 'XZ')
    trifolio(m, (0, -0.0, 2.25), 0.26)
    P["radiacao"] = m.mesh("sinal", 0.004)
    m = Malha("Marcador_Radiacao")
    m.cil((0, 0, 0.012), 0.8, 0.024, seg=28)
    m.toro((0, 0, 0.03), 0.7, 0.025, (0, 0, 1), 28, 5)
    for k in range(3):
        a = k * 2 * pi / 3
        m.box((cos(a) * 0.3, sin(a) * 0.3, 0.035), (0.32, 0.18, 0.02), yaw=a + pi / 2)
    P["marcador"] = m.mesh("sinal", 0.0)
    m = Malha("Placa_Baixa_Radiacao")                   # placa presa a cerca (baixa)
    m.prisma([(-0.3, 0.0), (0.3, 0.0), (0, 0.52)], -0.03, 0.0, 'XZ')
    trifolio(m, (0, 0.03, 0.2), 0.14)
    P["cerca"] = m.mesh("sinal", 0.003)
    return P


def painel_cerca(m, rng, x0, y0, x1, y1, h=2.1, dano=0.10):
    d = Vector((x1 - x0, y1 - y0, 0))
    comp = d.length
    if comp < 0.5:
        return
    ang = atan2(d.y, d.x)
    n = max(1, int(round(comp / 2.5)))
    w = comp / n
    for i in range(n):
        r = rng.random()
        if r < dano * 0.5:
            continue
        base = Matrix.Translation((x0 + d.x * i / n, y0 + d.y * i / n, alt(x0 + d.x * (i + .5) / n, y0 + d.y * (i + .5) / n) - 0.03)) @ Matrix.Rotation(ang, 4, 'Z')
        if r < dano:
            base = base @ Matrix.Rotation(rng.choice([-1, 1]) * rng.uniform(0.9, 1.3), 4, 'X')
        m.push(base)
        for px in (0.0, w):
            m.box((px, 0, h / 2.0), (0.1, 0.1, h))
        m.box((w / 2.0, 0, h - 0.03), (w, 0.06, 0.06))
        m.box((w / 2.0, 0, 0.12), (w, 0.06, 0.06))
        m.box((w / 2.0, 0, h / 2.0), (w, 0.04, 0.04))
        for k in range(int(w / 0.28)):
            m.box((0.14 + k * 0.28, 0, h / 2.0), (0.02, 0.02, h - 0.2))
        m.barra((0.05, 0, 0.15), (w - 0.05, 0, h - 0.15), 0.02, 0.02)
        m.pop()


def cerca_retangulo(m, rng, rr, abertura=None, h=2.1, dano=0.10):
    x0, x1, y0, y1 = rr
    lados = [((x0, y0), (x1, y0)), ((x1, y0), (x1, y1)), ((x1, y1), (x0, y1)), ((x0, y1), (x0, y0))]
    for (a, b) in lados:
        segs = [(a, b)]
        if abertura:
            ax, ay, w = abertura
            novo = []
            for (p, q) in segs:
                if abs(p[1] - ay) < 1e-6 and abs(q[1] - ay) < 1e-6 and min(p[0], q[0]) < ax < max(p[0], q[0]):
                    s = 1 if q[0] > p[0] else -1
                    novo += [(p, (ax - w / 2.0 * s, ay)), ((ax + w / 2.0 * s, ay), q)]
                else:
                    novo.append((p, q))
            segs = novo
        for (p, q) in segs:
            painel_cerca(m, rng, p[0], p[1], q[0], q[1], h, dano)


def portao(m, cx, cy, w, h, aberto_x):
    m.box((cx - w / 2.0, cy, h / 2.0), (0.3, 0.3, h))
    m.box((cx + w / 2.0, cy, h / 2.0), (0.3, 0.3, h))
    m.box((cx, cy, h + 0.1), (w + 0.3, 0.3, 0.25))
    for k in range(3):
        m.box((aberto_x, cy + 0.3, 0.3 + k * 0.7), (w * 0.55, 0.08, 0.06))
    for k in range(10):
        m.box((aberto_x - w * 0.27 + k * w * 0.06, cy + 0.3, h / 2.0 - 0.1), (0.04, 0.05, h - 0.4))
    m.barra((aberto_x - w * 0.27, cy + 0.3, 0.2), (aberto_x + w * 0.27, cy + 0.3, h - 0.3), 0.04, 0.04)


