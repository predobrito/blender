def limpar_cena():
    for o in list(bpy.data.objects):
        bpy.data.objects.remove(o, do_unlink=True)
    for c in list(bpy.data.collections):
        bpy.data.collections.remove(c)
    for me in list(bpy.data.meshes):
        if me.users == 0:
            bpy.data.meshes.remove(me)


def criar_colecoes():
    for n in NOMES_COLECOES:
        c = bpy.data.collections.new(n)
        bpy.context.scene.collection.children.link(c)
        COL[n] = c


def mat_cor(nome, cor, rug=0.9, var=0.18, escala=2.5, cor2=None, ruido2=0.0):
    """Material colorido com variacao procedural (ruido -> rampa de cor)."""
    m = bpy.data.materials.new(nome)
    m.use_nodes = True
    m.diffuse_color = (cor[0], cor[1], cor[2], 1)
    nt = m.node_tree
    b = nt.nodes.get("Principled BSDF")
    if not b:
        return m
    b.inputs["Roughness"].default_value = rug
    b.inputs["Base Color"].default_value = (cor[0], cor[1], cor[2], 1)
    try:
        tc = nt.nodes.new("ShaderNodeTexCoord")
        n1 = nt.nodes.new("ShaderNodeTexNoise")
        n1.inputs["Scale"].default_value = escala
        n1.inputs["Detail"].default_value = 6.0
        rp = nt.nodes.new("ShaderNodeValToRGB")
        c0 = cor2 if cor2 else tuple(max(0.0, c * (1 - var)) for c in cor)
        c1 = tuple(min(1.0, c * (1 + var)) for c in cor)
        rp.color_ramp.elements[0].color = (c0[0], c0[1], c0[2], 1)
        rp.color_ramp.elements[1].color = (c1[0], c1[1], c1[2], 1)
        rp.color_ramp.elements[0].position = 0.35
        rp.color_ramp.elements[1].position = 0.65
        nt.links.new(tc.outputs["Object"], n1.inputs["Vector"])
        nt.links.new(n1.outputs["Fac"], rp.inputs["Fac"])
        nt.links.new(rp.outputs["Color"], b.inputs["Base Color"])
    except Exception as ex:
        print("variacao de cor ignorada:", ex)
    return m


