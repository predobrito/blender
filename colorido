def roda(m, c, r, w, murcha=1.0, lugs=False):
    Y = (0, 1, 0)
    rr = r * murcha
    cz = c[2] - (r - rr)
    m.cil((c[0], c[1], cz), rr, w, Y, seg=18)
    m.cil((c[0], c[1], cz), rr * 0.62, w * 1.04, Y, seg=14)
    m.cil((c[0], c[1], cz), rr * 0.22, w * 1.12, Y, seg=10)
    if lugs:
        for k in range(14):
            a = 2 * pi * k / 14
            m.box((c[0] + cos(a) * rr, c[1], cz + sin(a) * rr), (0.12, w * 0.95, 0.06), ry=-a)
    for k in range(5):
        a = 2 * pi * k / 5
        m.cil((c[0] + cos(a) * rr * 0.4, c[1] + (w / 2.0 + 0.02) * (1 if c[1] > 0 else -1), cz + sin(a) * rr * 0.4),
              0.02, 0.04, Y, seg=6)


def far(m, p, d=(1, 0, 0), r=0.09):
    m.cil(p, r, 0.06, d, seg=12)
    m.cil(Vector(p) + Vector(d) * 0.03, r * 0.7, 0.04, d, seg=12)


def sedan(nome, perua=False):
    m = Malha(nome)
    L, W = 4.1, 1.6
    m.box((0, 0, 0.55), (L, W, 0.5))
    m.box((0.95, 0, 0.88), (1.5, W - 0.05, 0.16))                   # capo
    m.box((-1.15, 0, 0.88), (1.1, W - 0.05, 0.16))                  # porta-malas
    cab = [(-1.0, 0.0), (-0.75, 0.52), (0.45, 0.52), (0.85, 0.0)] if not perua else \
          [(-1.55, 0.0), (-1.45, 0.52), (0.45, 0.52), (0.85, 0.0)]
    m.prisma([(x, z) for x, z in [(x + 0.1, z + 0.96) for x, z in cab]], -W / 2.0 + 0.1, W / 2.0 - 0.1, 'XZ')
    m.box((0, 0, 1.5), (1.3 if not perua else 1.9, W - 0.2, 0.05), ry=0.0)
    for sy in (-1, 1):                                              # colunas
        for x in (-0.52, 0.52):
            m.box((x - 0.05, sy * (W / 2.0 - 0.1), 1.2), (0.07, 0.07, 0.5), ry=0.0)
        m.box((0.0, sy * (W / 2.0 + 0.005), 0.78), (3.6, 0.02, 0.03))
        m.box((0.05, sy * (W / 2.0 + 0.01), 0.7), (0.03, 0.03, 0.55))
        m.box((-0.8, sy * (W / 2.0 + 0.01), 0.7), (0.03, 0.03, 0.55))
        m.box((0.4, sy * (W / 2.0 + 0.04), 0.85), (0.12, 0.03, 0.03))
        m.box((-0.45, sy * (W / 2.0 + 0.04), 0.85), (0.12, 0.03, 0.03))
        m.box((0.58, sy * (W / 2.0 + 0.1), 1.08), (0.15, 0.12, 0.09))
    m.box((2.1, 0, 0.35), (0.12, W + 0.1, 0.16))
    m.box((-2.1, 0, 0.35), (0.12, W + 0.1, 0.16))
    for sy in (-1, 1):
        far(m, (2.06, sy * 0.55, 0.65))
        far(m, (-2.06, sy * 0.55, 0.65), (-1, 0, 0), 0.07)
    for k in range(5):
        m.box((2.05, 0, 0.58 + k * 0.03), (0.02, 0.6, 0.015))
    # porta entreaberta e rodas (uma murcha)
    m.box((-0.2, W / 2.0 + 0.35, 0.8), (0.8, 0.05, 0.6), yaw=0.8)
    for (x, sy, mu) in ((1.3, 1, 1.0), (1.3, -1, 1.0), (-1.25, 1, 0.75), (-1.25, -1, 1.0)):
        roda(m, (x, sy * (W / 2.0 - 0.1), 0.3), 0.3, 0.2, mu)
    return m.mesh("veic_perua" if perua else "veic_sedan", 0.012)


def van(nome):
