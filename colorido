def malha_poste(nome, braco=1.6, duplo=False):
    m = Malha(nome)
    m.cil((0, 0, 3.75), 0.11, 7.5, seg=10, r2=0.07)
    m.cil((0, 0, 0.35), 0.17, 0.7, seg=10)
    m.cil((0, 0, 0.72), 0.2, 0.06, seg=10)
    for sg in ((1,) if not duplo else (1, -1)):
        m.tubo((0, 0, 7.2), (sg * braco * 0.6, 0, 7.55), 0.04, 6)
        m.tubo((sg * braco * 0.6, 0, 7.55), (sg * braco, 0, 7.45), 0.04, 6)
        m.box((sg * braco, 0, 7.38), (0.55, 0.22, 0.1))
        m.cil((sg * braco, 0, 7.3), 0.12, 0.1, seg=10, r2=0.18)
    m.box((0, 0, 6.6), (0.3, 0.12, 0.05))
    m.box((0, 0, 7.0), (0.6, 0.05, 0.05))
    for sg in (-1, 1):
        m.cil((sg * 0.3, 0, 7.04), 0.025, 0.06, seg=6)
    return m.mesh("luz", 0.006)


def fios(m, a, b, sag, n=9, r=0.012):
    a, b = Vector(a), Vector(b)
    pts = []
    for i in range(n + 1):
        t = i / n
        p = a + (b - a) * t
        p.z -= sag * 4.0 * t * (1 - t)
        pts.append(p)
    m.cabo(pts, r, 4)


def iluminacao():
    rng = random.Random(SEED + 61)
    mp = [malha_poste("Poste_A", 1.6), malha_poste("Poste_B", 1.4, True), malha_poste("Poste_C", 1.1)]
    w = Malha("Fios_Eletricos")
    linhas = {}
    for v in VIAS:
        h = v['l'] / 2.0
        for sg in (-1, 1):
            off = sg * (h + 1.0)
            pos = []
            t = v['a'] + 8 + (6 if sg > 0 else 0)
            while t < v['b'] - 4:
                x, y = (t, v['c'] + off) if v['eixo'] == 'x' else (v['c'] + off, t)
                ok = not dentro(x, y, LIVRE_INICIAL, 4.0)
                ok = ok and not any(dentro(x, y, ret_via(u), 2.0) for u in VIAS if u is not v)
                ok = ok and not any(dentro(x, y, ret_predio(p, 0.5)) for p in PREDIOS)
                if ok:
                    pos.append((x, y))
                t += 20.0
            for (x, y) in pos:
                tilt = rng.uniform(-0.1, 0.1) if rng.random() < 0.25 else 0.0
                yaw = ((pi / 2) * (1 if sg < 0 else -1)) if v['eixo'] == 'x' else (pi if sg > 0 else 0.0)
                if v['eixo'] == 'y':
                    yaw = 0.0 if sg > 0 else pi
                    yaw = pi / 2 if sg < 0 else -pi / 2
                instancia("Poste", rng.choice(mp), "ILUMINACAO", (x, y, alt(x, y) if not any(dentro(x, y, ret_via(u), CAL_L) for u in VIAS) else Z_CAL), (tilt, 0, yaw))
            linhas[(v['nome'], sg)] = pos
    for (k, pos) in linhas.items():
        for a, b in zip(pos[:-1], pos[1:]):
            if hypot(b[0] - a[0], b[1] - a[1]) > 24.0:
                continue
            for dz, dy in ((7.0, 0.0), (6.7, 0.0), (6.4, 0.0)):
                fios(w, (a[0], a[1], dz), (b[0], b[1], dz), 0.45)
        # fio solto pendurado (ponta a 3,3 m do chao)
        if len(pos) > 2 and rng.random() < 0.7:
            a = pos[1]
            fios(w, (a[0], a[1], 7.0), (a[0] + 4.0, a[1], 3.3), 0.2, 6)
    w.objeto("ILUMINACAO", "luz", 0.0)
    # lampadas industriais em paredes de galpoes e na usina
    l = Malha("Lampadas_Industriais")
    for (x, y, d) in ((26.0, 49.0, (0, -1)), (37.0, 48.8, (0, -1)), (48.0, 48.8, (0, -1)), (44.0, 33.8, (0, -1)), (51.0, 33.8, (0, -1)),
                      (60.0, 33.8, (0, -1)), (74.0, 33.8, (0, -1)), (50.0, 49.0, (0, -1))):
        l.tubo((x, y, 4.3), (x + d[0] * 0.5, y + d[1] * 0.5, 4.5), 0.03, 6)
        l.cil((x + d[0] * 0.6, y + d[1] * 0.6, 4.4), 0.12, 0.22, seg=10, r2=0.2)
        l.cil((x + d[0] * 0.6, y + d[1] * 0.6, 4.28), 0.08, 0.06, seg=10)
    for (x, y) in ((24.0, 46.5), (73.0, 46.5), (24.0, 73.0)):
        l.cil((x, y, 5.0), 0.1, 10.0, seg=8)
        l.box((x, y, 10.1), (0.9, 0.5, 0.3))
        for k in range(3):
            l.cil((x + (k - 1) * 0.28, y - 0.28, 10.1), 0.09, 0.1, (0, 1, 0), seg=10)
    l.objeto("ILUMINACAO", "metal", 0.008)


