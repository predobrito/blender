def roda_gigante():
    rng = random.Random(SEED + 7)
    m = Malha("Roda_Gigante")
    cx, cy = RODA_GIGANTE
    R, zh = 9.0, 10.6
    m.push(Matrix.Translation((cx, cy, 0)))
    N = 24
    for yy in (-0.9, 0.9):
        for k in range(N):
            a0, a1 = 2 * pi * k / N, 2 * pi * (k + 1) / N
            p0 = (R * cos(a0), yy, zh + R * sin(a0))
            p1 = (R * cos(a1), yy, zh + R * sin(a1))
            m.tubo(p0, p1, 0.07, 6)
            m.tubo((R * 0.6 * cos(a0), yy, zh + R * 0.6 * sin(a0)),
                   (R * 0.6 * cos(a1), yy, zh + R * 0.6 * sin(a1)), 0.04, 5)
            m.tubo((0, yy, zh), p0, 0.035, 5)
    for k in range(N):
        a = 2 * pi * k / N
        m.tubo((R * cos(a), -0.9, zh + R * sin(a)), (R * cos(a), 0.9, zh + R * sin(a)), 0.045, 5)
    m.cil((0, 0, zh), 0.55, 2.4, (0, 1, 0), seg=20)
    m.cil((0, 0, zh), 0.8, 0.3, (0, 1, 0), seg=20)
    m.cil((0, 1.5, zh), 0.8, 0.3, (0, 1, 0), seg=20)
    # gondolas (algumas faltam)
    for k in range(12):
        if k in (3, 8):
            continue
        a = 2 * pi * k / 12 + 0.12
        gx, gz = R * cos(a), zh + R * sin(a)
        m.tubo((gx, -0.9, gz), (gx, 0.9, gz), 0.05, 6)
        m.box((gx, 0.0, gz - 0.95), (1.3, 1.1, 1.0), rx=rng.uniform(-0.05, 0.05))
        m.box((gx, 0.0, gz - 0.35), (1.1, 1.0, 0.06))
        m.box((gx, 0.0, gz - 0.35), (1.5, 1.3, 0.1))
        for sx in (-1, 1):
            m.tubo((gx + sx * 0.5, 0, gz - 0.4), (gx, 0, gz), 0.02, 5)
    # cavaletes laterais
    for yy in (-1.6, 1.6):
        for sx in (-1, 1):
            m.tubo((sx * 0.2, yy * 0.5, zh), (sx * 4.2, yy * 2.0, 0.0), 0.16, 8)
            m.box((sx * 4.2, yy * 2.0, 0.15), (1.2, 1.2, 0.4))
        m.tubo((-4.2, yy * 2.0, 1.2), (4.2, yy * 2.0, 1.2), 0.07, 6)
    m.cil((0, 0, 1.0), 0.0001, 0.0001, seg=3)
    m.pop()
    m.objeto("EDIFICIOS", "predio", 0.02)


