# EDIFICIOS SOVIETICOS (paineis de concreto, janelas por celula, sacadas, buracos)
# ----------------------------------------------------------------------------
CFG = {
    "res": dict(H=3.0, sill=0.9, wh=1.5, wmax=1.5, balcao=True),
    "escola": dict(H=3.6, sill=0.9, wh=1.9, wmax=2.6, balcao=False),
    "loja": dict(H=5.0, sill=0.5, wh=3.6, wmax=3.4, balcao=False),
    "cultura": dict(H=5.0, sill=1.0, wh=2.6, wmax=1.6, balcao=False),
}
PL = 0.45   # soco elevado do predio


def entulho_chao(m, rng, x, y, n, raio, zbase=0.0, evitar=None):
    """Pedacos de concreto caidos (geometria fundida na malha do predio)."""
    for _ in range(n):
        a = rng.uniform(0, 2 * pi)
        d = rng.uniform(0, raio)
        px, py = x + cos(a) * d, y + sin(a) * d
        if evitar and any(abs(px - ex) < 2.0 for ex in evitar):
            continue
        s = rng.uniform(0.2, 0.7)
        m.box((px, py, zbase + s * 0.3), (s * rng.uniform(0.8, 1.6), s * rng.uniform(0.6, 1.3), s * 0.6),
              yaw=rng.uniform(0, pi), rx=rng.uniform(-0.3, 0.3), ry=rng.uniform(-0.3, 0.3))


def ferragens(m, rng, c, d, n=4):
    """Vergalhoes expostos saindo de uma borda quebrada."""
    c = Vector(c)
    d = Vector(d).normalized()
    for k in range(n):
        off = Vector((rng.uniform(-0.5, 0.5), rng.uniform(-0.15, 0.15), rng.uniform(-0.4, 0.4)))
        p = c + off
        dd = (d + Vector((rng.uniform(-0.2, 0.2), rng.uniform(-0.2, 0.2), rng.uniform(-0.3, 0.1)))).normalized()
        m.tubo(p, p + dd * rng.uniform(0.4, 1.0), 0.012, 5)


def predio(nome, tipo, cx, cy, yaw, L, W, n, bw, colapso, seed, extra=None):
    rng = random.Random(seed)
    cfg = CFG[tipo]
    H = cfg['H']
    m = Malha(nome)
    m.base = Matrix.Translation((cx, cy, 0)) @ Matrix.Rotation(yaw, 4, 'Z')
    nb = max(2, int(round(L / bw)))
    bw = L / nb
    e = 0.40
    ztopo = PL + n * H
    entradas = [i for i in range(1, nb - 1, 3)] if tipo in ("res",) else ([nb // 2] if nb % 2 else [nb // 2 - 1, nb // 2])
    if tipo == "loja":
        entradas = [nb // 2 - 1, nb // 2]
    ent_x = [-L / 2 + (i + 0.5) * bw for i in entradas]

    # fundacao + lajes de piso
    m.box((0, 0, (PL - 0.8) / 2.0), (L + 0.6, W + 0.6, PL + 0.8))
    for f in range(0, n + 1):
        z = PL + f * H
        if f == n:
            continue
        if f >= n - 2 and rng.random() < 0.25 and n > 3:
            m.box((-L * 0.18, 0, z), (L * 0.64, W - 0.8, 0.22))
        else:
            m.box((0, 0, z), (L - 0.8, W - 0.8, 0.22))

    def P(eixo, lado, u, v, z, su, sv, sz, **kw):
        if eixo == 'x':
            m.box((u, lado * W / 2.0 + v, z), (su, sv, sz), **kw)
        else:
            m.box((lado * L / 2.0 + v, u, z), (sv, su, sz), **kw)

    def parede(eixo, lado, frente):
        comp = L if eixo == 'x' else W
        nc = nb if eixo == 'x' else max(2, int(round(W / bw)))
        cw = comp / nc
        ww = min(cfg['wmax'], cw * 0.55)
        for f in range(n):
            z0 = PL + f * H
            hole = []
            tipos = []
            larg = []
            for i in range(nc):
                u = -comp / 2.0 + (i + 0.5) * cw
                h = False
                if colapso and f >= n - 2 and ((eixo == 'x' and u > L / 2.0 - 2.3 * bw) or (eixo == 'y' and lado == 1)):
                    h = True
                elif rng.random() < 0.015 + 0.03 * f / max(1, n - 1):
                    h = True
                hole.append(h)
                if eixo == 'x' and frente and f == 0 and i in entradas:
                    tipos.append('porta')
                    larg.append(1.7 if tipo != 'loja' else 2.6)
                else:
                    tipos.append('janela')
                    larg.append(ww)
            for i in range(nc):
                u = -comp / 2.0 + (i + 0.5) * cw
                if hole[i]:
                    if f >= 1 or True:
                        ferragens(m, rng, _p(eixo, lado, u, 0.0, z0 + H - 0.1), _d(eixo, lado, 0.7), 3)
                    continue
                if tipos[i] == 'porta':
                    dh = 2.3 if tipo != 'loja' else 3.0
                    P(eixo, lado, u, 0, z0 + dh + (H - dh) / 2.0, larg[i], e, H - dh)
                    continue
                sill, wh = cfg['sill'], cfg['wh']
                P(eixo, lado, u, 0, z0 + sill / 2.0, larg[i], e, sill)
                P(eixo, lado, u, 0, z0 + sill + wh + (H - sill - wh) / 2.0, larg[i], e, H - sill - wh)
                # caixilho
                r = rng.random()
                zc = z0 + sill + wh / 2.0
                if r < 0.50:
                    P(eixo, lado, u - larg[i] / 2 + 0.03, 0.0, zc, 0.05, 0.10, wh)
                    P(eixo, lado, u + larg[i] / 2 - 0.03, 0.0, zc, 0.05, 0.10, wh)
                    P(eixo, lado, u, 0.0, zc, larg[i], 0.08, 0.04)
                    P(eixo, lado, u, 0.0, z0 + sill + 0.03, larg[i], 0.10, 0.05)
                elif r < 0.78:
                    P(eixo, lado, u - larg[i] / 2 + 0.03, 0.0, zc, 0.05, 0.10, wh)
                    P(eixo, lado, u, 0.0, z0 + sill + wh - 0.03, larg[i], 0.10, 0.05)
                if r > 0.30 and r < 0.9:
                    P(eixo, lado, u + rng.uniform(-0.3, 0.3), 0.05, z0 + sill + 0.08, 0.30, 0.02, 0.22,
                      rx=rng.uniform(-0.6, 0.6))
                # sacadas
                if cfg['balcao'] and eixo == 'x' and frente and f >= 1 and i % 3 == 2:
                    s = lado
                    q = rng.random()
                    if q < 0.12:
                        pass
                    elif q < 0.24:
                        P('x', lado, u, s * 0.9, z0 - 0.55, 3.0, 1.1, 0.14, rx=0.65 * (-s))
                    else:
                        P('x', lado, u, s * 0.75, z0 - 0.07, 3.0, 1.1, 0.14)
                        P('x', lado, u, s * 1.28, z0 + 0.5, 3.0, 0.08, 1.0)
                        if rng.random() < 0.8:
                            P('x', lado, u - 1.46, s * 0.75, z0 + 0.5, 0.08, 1.1, 1.0)
                        if rng.random() < 0.8:
                            P('x', lado, u + 1.46, s * 0.75, z0 + 0.5, 0.08, 1.1, 1.0)
            # pilares entre vaos
            for i in range(nc + 1):
                if i > 0 and hole[i - 1]:
                    continue
                if i < nc and hole[i]:
                    continue
                lw = larg[i - 1] / 2.0 if i > 0 else 0.0
                rw = larg[i] / 2.0 if i < nc else 0.0
                ub = -comp / 2.0 + i * cw
                left = ub - (cw / 2.0 - lw) if i > 0 else -comp / 2.0
                right = ub + (cw / 2.0 - rw) if i < nc else comp / 2.0
                if right - left > 0.05:
                    P(eixo, lado, (left + right) / 2.0, 0, z0 + H / 2.0, right - left, e, H)
        return

    def _p(eixo, lado, u, v, z):
        return (u, lado * W / 2.0 + v, z) if eixo == 'x' else (lado * L / 2.0 + v, u, z)

    def _d(eixo, lado, k):
        return (0, lado * k, 0) if eixo == 'x' else (lado * k, 0, 0)

    parede('x', -1, True)
    parede('x', 1, False)
    parede('y', -1, False)
    parede('y', 1, False)

    # interior: parede-eixo, paredes transversais, escadas
    for f in range(n):
        z0 = PL + f * H
        for i in range(nb):
            u = -L / 2.0 + (i + 0.5) * bw
            if rng.random() > 0.18 and not (colapso and f >= n - 2 and u > L / 2.0 - 2.3 * bw):
                m.box((u, 0, z0 + H / 2.0), (bw - 0.1, 0.22, H - 0.22))
        for i in range(2, nb - 1, 2):
            u = -L / 2.0 + i * bw
            if rng.random() > 0.25 and not (colapso and f >= n - 2 and u > L / 2.0 - 2.3 * bw):
                m.box((u, 0, z0 + H / 2.0), (0.2, W - 0.8, H - 0.22))
    if tipo in ("res", "escola"):
        for i in entradas:
            u = -L / 2.0 + (i + 0.5) * bw
            ns = int(H / 0.18)
            rr, dd = H / ns, 0.27
            pf = [(0, 0)]
            for k in range(ns):
                pf += [(k * dd, (k + 1) * rr), ((k + 1) * dd, (k + 1) * rr)]
            pf += [(ns * dd, 0)]
            for f in range(n):
                y0 = -W / 2.0 + 2.6
                pts = [(y0 + a, z) for a, z in pf]
                m.prisma([(a, PL + f * H + z) for a, z in pts], u - 0.65, u + 0.65, 'YZ')

    # entradas: rampa, corrimao, marquise
    for i in entradas:
        u = -L / 2.0 + (i + 0.5) * bw
        yw = -W / 2.0 - e / 2.0
        wd = 1.0 if tipo != 'loja' else 1.8
        m.prisma([(yw, -0.2), (yw, PL), (yw - 4.6, 0.0), (yw - 4.6, -0.2)], u - wd, u + wd, 'YZ')
        for sg in (-1, 1):
            m.tubo((u + sg * (wd + 0.12), yw - 0.1, PL + 0.9), (u + sg * (wd + 0.12), yw - 4.5, 0.9), 0.025, 6)
            for k in (0.0, 2.2, 4.4):
                zz = PL + 0.9 - (PL * k / 4.6)
                m.tubo((u + sg * (wd + 0.12), yw - 0.1 - k, 0.0), (u + sg * (wd + 0.12), yw - 0.1 - k, zz), 0.025, 6)
        m.box((u, -W / 2.0 - 0.9, PL + (H if tipo != 'loja' else 3.6) - 0.1), (3.2 if tipo != 'loja' else 5.2, 2.0, 0.2))
        for sg in (-1, 1):
            m.box((u + sg * 1.5, -W / 2.0 - 0.9, PL + H - 0.45), (0.15, 2.0, 0.7 if tipo != 'loja' else 0.5))
        # porta aberta (folha girada)
        a = rng.uniform(1.0, 1.5)
        hx = u - 0.75
        m.box((hx + cos(a) * 0.38, -W / 2.0 - sin(a) * 0.38, PL + 1.1), (0.76, 0.06, 2.2), yaw=-a)

    # entulho junto as paredes e ao canto colapsado
    for _ in range(int(2 + n * 0.8)):
        u = rng.uniform(-L / 2.0 + 1, L / 2.0 - 1)
        entulho_chao(m, rng, u, rng.choice([-1, 1]) * (W / 2.0 + 1.3), rng.randint(2, 4), 1.0, 0.0, ent_x)
    if colapso:
        entulho_chao(m, rng, L / 2.0 - 3.0, W / 2.0 + 1.5, 20, 4.5, 0.0)
        entulho_chao(m, rng, L / 2.0 + 1.5, 0.0, 14, 3.5, 0.0)

    # tubulacoes externas
    for i in range(0, nb + 1, 3):
        ub = -L / 2.0 + i * bw
        if i == 0 or i == nb:
            ub = ub + (0.5 if i == 0 else -0.5)
        for sg in (-1, 1):
            zt = ztopo - 0.4 if rng.random() > 0.25 else ztopo - rng.uniform(4, 8)
            m.cil((ub, sg * (W / 2.0 + 0.18), (PL + zt) / 2.0), 0.07, zt - PL, seg=8)
            for f in range(0, n, 2):
                m.box((ub, sg * (W / 2.0 + 0.12), PL + f * H + 1.0), (0.14, 0.14, 0.06))
    cabo_gas = [(-L / 2.0 + 1.0, -W / 2.0 - 0.3, PL + 0.7), (L / 2.0 - 1.0, -W / 2.0 - 0.3, PL + 0.7)]
    m.cabo(cabo_gas, 0.045)
    for k in range(6):
        u = -L / 2.0 + 1.0 + k * (L - 2.0) / 5.0
        m.box((u, -W / 2.0 - 0.25, PL + 0.6), (0.06, 0.1, 0.25))

    # cobertura: laje, parapeito, casa de maquinas, caixa d'agua, antenas
    if tipo in ("res", "escola", "loja"):
        m.box((0, 0, ztopo + 0.1), (L + 0.2, W + 0.2, 0.3))
        for s in (-1, 1):
            for (u0, u1) in ((-L / 2.0, -L / 8.0), (-L / 8.0, L / 2.0)):
                if rng.random() > 0.15 and not (colapso and s == 1 and u1 > L / 3.0):
                    m.box(((u0 + u1) / 2.0, s * (W / 2.0 - 0.1), ztopo + 0.7), (u1 - u0, 0.2, 0.9))
        m.box((-L / 2.0 + 0.1, 0, ztopo + 0.7), (0.2, W, 0.9))
        m.box((L / 2.0 - 0.1, 0, ztopo + 0.7), (0.2, W, 0.9)) if not colapso else None
        if tipo == "res":
            for u in (-L * 0.30, L * 0.05):
                m.box((u, -W * 0.15, ztopo + 1.7), (3.2, 3.0, 2.8))
                m.box((u, -W * 0.15 - 1.55, ztopo + 1.0), (1.0, 0.1, 1.6))
            m.cil((-L * 0.05, W * 0.18, ztopo + 1.3), 1.2, 2.0, seg=16)
            for k in range(4):
                a = k * pi / 2 + pi / 4
                m.cil((-L * 0.05 + cos(a) * 0.9, W * 0.18 + sin(a) * 0.9, ztopo + 0.6), 0.05, 0.8, seg=6)
            for u in (-L * 0.4, L * 0.22, L * 0.34):
                m.cil((u, W * 0.2, ztopo + 0.8), 0.13, 1.0, seg=10)
                m.cil((u, W * 0.2, ztopo + 1.34), 0.2, 0.1, seg=10)
            for u in (-L * 0.15, L * 0.18):
                m.tubo((u, 0.5, ztopo + 0.25), (u, 0.5, ztopo + 4.5), 0.03, 5)
                for k in range(3):
                    m.box((u, 0.5, ztopo + 2.3 + k * 0.7), (0.05, 1.6 - k * 0.3, 0.03))
        if tipo == "escola":
            m.box((0, 0, ztopo + 1.2), (8.0, 5.0, 2.2))

    if extra:
        extra(m, rng, L, W, H, n, ztopo)
    return m, ent_x


def colunata_cultura(m, rng, L, W, H, n, ztopo):
    """Casa de Cultura: portico de colunas, escadaria larga, volume alto, cobertura inclinada."""
    zf = PL + n * H
    m.box((0, 0, zf + 0.15), (L + 0.4, W + 0.4, 0.4))
    m.box((0, -W / 2.0 - 3.0, zf - 0.6), (L - 2.0, 6.0, 0.5))
    for k in range(7):
        x = -L / 2.0 + 2.0 + k * (L - 4.0) / 6.0
        m.cil((x, -W / 2.0 - 5.0, PL + (zf - PL) / 2.0 - 0.3), 0.42, zf - PL - 0.6, seg=14)
        m.cil((x, -W / 2.0 - 5.0, PL + 0.1), 0.55, 0.2, seg=14)
        m.cil((x, -W / 2.0 - 5.0, zf - 0.8), 0.55, 0.2, seg=14)
    for k in range(3):
        m.box((0, -W / 2.0 - 6.0 - k * 0.5, PL * (1 - (k + 1) / 4.0) - 0.05), (L - 2.0, 0.5, PL * (1 - (k + 1) / 4.0) + 0.1))
    m.box((0, 2.0, zf + 2.2), (L * 0.6, W * 0.5, 4.0))
    for s in (-1, 1):
        m.box((s * (L / 2.0 + 0.2), 0, PL + 1.6), (0.4, W + 0.2, 3.2))


