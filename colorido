        on_cal = any(dentro(x, y, ret_via(v), CAL_L) and not dentro(x, y, ret_via(v)) for v in VIAS)
        if any(dentro(x, y, ret_via(v)) for v in VIAS) and g in ("laje", "tubo"):
            continue
        z = Z_CAL if on_cal else (Z_VIA if any(dentro(x, y, ret_via(v)) for v in VIAS) else None)
