def malha_arvore(seed, altura, folhas, nome):
    rng = random.Random(seed)
    m = Malha(nome)

    def ramo(p, d, r, comp, nivel):
        p2 = p + d * comp
        m.tubo(p, p2, r, 6, r * 0.65)
        if nivel <= 0 or comp < 0.45:
            if rng.random() < folhas:
                m.esfera(p2, rng.uniform(0.5, 1.1), (1, 1, 0.6), 0.25, rng)
            return
        for _ in range(rng.randint(2, 3)):
            nd = (d + Vector((rng.uniform(-1, 1), rng.uniform(-1, 1), rng.uniform(-0.1, 0.8)))).normalized()
            ramo(p2, nd, r * 0.6, comp * rng.uniform(0.55, 0.8), nivel - 1)
        nd = (d + Vector((rng.uniform(-0.25, 0.25), rng.uniform(-0.25, 0.25), 0.1))).normalized()
        ramo(p2, nd, r * 0.78, comp * 0.8, nivel - 1)

    tr = altura * 0.45
    tilt = Vector((rng.uniform(-0.12, 0.12), rng.uniform(-0.12, 0.12), 1.0)).normalized()
    m.tubo((0, 0, -0.2), tilt * tr, 0.22, 8, 0.15)
    for k in range(3):                                   # galhos baixos secos
        a = rng.uniform(0, 2 * pi)
        base = tilt * (tr * (0.35 + 0.2 * k))
        d = Vector((cos(a), sin(a), rng.uniform(0.2, 0.7))).normalized()
        ramo(base, d, 0.07, altura * 0.18, 2)
    ramo(tilt * tr, tilt, 0.15, altura * 0.28, 4)
    return m.mesh("veg", 0.0)


def malha_pinheiro(seed, altura, nome):
    rng = random.Random(seed)
    m = Malha(nome)
    m.cil((0, 0, altura * 0.4), 0.16, altura * 0.8, seg=8, r2=0.07)
    n = 7
    for k in range(n):
        z = altura * (0.25 + 0.75 * k / n)
        r = 1.9 * (1 - k / (n + 1.0)) * rng.uniform(0.8, 1.1)
        if rng.random() < 0.15:
            continue
        m.cil((rng.uniform(-0.1, 0.1), rng.uniform(-0.1, 0.1), z), r, 0.9, seg=9, r2=0.1)
    return m.mesh("veg", 0.0)


def malha_arbusto(seed, nome):
    rng = random.Random(seed)
    m = Malha(nome)
    for _ in range(rng.randint(4, 7)):
        m.esfera((rng.uniform(-0.6, 0.6), rng.uniform(-0.6, 0.6), rng.uniform(0.25, 0.6)), rng.uniform(0.35, 0.65),
                 (1, 1, 0.8), 0.3, rng)
    for _ in range(5):
        a = rng.uniform(0, 2 * pi)
        m.tubo((0, 0, 0), (cos(a) * 0.8, sin(a) * 0.8, rng.uniform(0.6, 1.1)), 0.02, 4, 0.01)
    return m.mesh("veg", 0.0)


def malha_capim(seed, altura, n, nome, raio=0.25):
    rng = random.Random(seed)
    m = Malha(nome)
    for _ in range(n):
        a = rng.uniform(0, 2 * pi)
        d = rng.uniform(0, raio)
        x, y = cos(a) * d, sin(a) * d
        h = altura * rng.uniform(0.5, 1.0)
        b = rng.uniform(0, 2 * pi)
        dx, dy = cos(b) * h * 0.35, sin(b) * h * 0.35
        w = 0.015 + altura * 0.015
        px, py = -sin(b) * w, cos(b) * w
        m.lamina([(x - px, y - py, 0), (x + px, y + py, 0),
                  (x + px * 0.6 + dx * 0.5, y + py * 0.6 + dy * 0.5, h * 0.6),
                  (x + dx, y + dy, h)])
    return m.mesh("veg", 0.0)


def malha_raiz(seed, nome):
    rng = random.Random(seed)
    m = Malha(nome)
    for k in range(5):
        a = k * 2 * pi / 5 + rng.uniform(-0.3, 0.3)
        p = Vector((0, 0, 0.18))
        d = Vector((cos(a), sin(a), 0))
        r = 0.11
        for s in range(5):
            q = p + d * rng.uniform(0.35, 0.6)
            q.z = max(0.02, 0.18 - s * 0.04)
            m.tubo(p, q, r, 6, r * 0.7)
            p, r = q, r * 0.7
            d = (d + Vector((rng.uniform(-0.4, 0.4), rng.uniform(-0.4, 0.4), 0))).normalized()
    return m.mesh("veg", 0.0)


def vegetacao():
    rng = random.Random(SEED + 21)
    arv = [malha_arvore(100 + i, rng.uniform(5.5, 9.0), f, "Arvore_%d" % i)
           for i, f in enumerate((0.08, 0.15, 0.30, 0.35, 0.55, 0.6))]
    pin = [malha_pinheiro(200 + i, rng.uniform(6.0, 10.0), "Pinheiro_%d" % i) for i in range(2)]
    arb = [malha_arbusto(300 + i, "Arbusto_%d" % i) for i in range(3)]
    cap_b = [malha_capim(400 + i, 0.35, 14, "Capim_%d" % i) for i in range(4)]
    cap_a = [malha_capim(500 + i, 1.15, 22, "CapimAlto_%d" % i, 0.4) for i in range(3)]
    raiz = [malha_raiz(600 + i, "Raiz_%d" % i) for i in range(3)]
    bloq_arv = rects_bloqueio(2.0)
    bloq_arb = rects_bloqueio(0.8)
    bloq_cap = rects_bloqueio(0.0)
    cont = 0

    def aleatorio(bloq, margem_borda=2.0):
        for _ in range(60):
            x = rng.uniform(-MET + margem_borda, MET - margem_borda)
            y = rng.uniform(-MET + margem_borda, MET - margem_borda)
            if not bloqueado(x, y, bloq):
                return x, y
        return None

    # arvores: agrupadas (bosques irregulares) + isoladas
    centros = [(rng.uniform(-70, 70), rng.uniform(-70, 70)) for _ in range(14)]
    for k in range(170):
        if k < 110:
            cx, cy = rng.choice(centros)
            x, y = cx + rng.gauss(0, 7.0), cy + rng.gauss(0, 7.0)
            if abs(x) > MET - 2 or abs(y) > MET - 2 or bloqueado(x, y, bloq_arv):
                continue
        else:
            p = aleatorio(bloq_arv)
            if not p:
                continue
            x, y = p
        esc = rng.uniform(0.75, 1.35)
        me = rng.choice(pin) if rng.random() < 0.22 else rng.choice(arv)
        instancia("Arvore", me, "VEGETACAO", (x, y, alt(x, y)), (0, 0, rng.uniform(0, 2 * pi)), esc)
        cont += 1
        if rng.random() < 0.6:
            instancia("Raiz", rng.choice(raiz), "VEGETACAO", (x, y, alt(x, y) - 0.02), (0, 0, rng.uniform(0, 2 * pi)), esc * 1.2)
        for _ in range(rng.randint(0, 3)):
            qx, qy = x + rng.gauss(0, 1.5), y + rng.gauss(0, 1.5)
            if not bloqueado(qx, qy, bloq_cap):
                instancia("Capim", rng.choice(cap_a), "VEGETACAO", (qx, qy, alt(qx, qy)), (0, 0, rng.uniform(0, 6.28)), rng.uniform(0.8, 1.3))
    for _ in range(260):
        p = aleatorio(bloq_arb)
        if p:
            x, y = p
            instancia("Arbusto", rng.choice(arb), "VEGETACAO", (x, y, alt(x, y) - 0.05),
                      (0, 0, rng.uniform(0, 6.28)), rng.uniform(0.7, 1.4))
    for _ in range(520):
        p = aleatorio(bloq_cap, 0.5)
        if p:
            x, y = p
            me = rng.choice(cap_a) if rng.random() < 0.35 else rng.choice(cap_b)
            instancia("Capim", me, "VEGETACAO", (x, y, alt(x, y)), (0, 0, rng.uniform(0, 6.28)), rng.uniform(0.8, 1.4))
    # plantas crescendo nas rachaduras das ruas e calcadas
    for _ in range(420):
        v = rng.choice(VIAS)
        h = v['l'] / 2.0
        t = rng.uniform(v['a'] + 1, v['b'] - 1)
        if rng.random() < 0.55:
            off = rng.choice([-1, 1]) * (h - rng.uniform(0.05, 0.6))
            z = Z_VIA
        else:
            off = rng.choice([-1, 1]) * (h + rng.uniform(0.2, CAL_L - 0.2))
            z = Z_CAL
        x, y = (t, v['c'] + off) if v['eixo'] == 'x' else (v['c'] + off, t)
        if dentro(x, y, LIVRE_INICIAL):
            continue
        instancia("Erva", rng.choice(cap_b), "VEGETACAO", (x, y, z), (0, 0, rng.uniform(0, 6.28)), rng.uniform(0.5, 1.0))
    # vegetacao junto das fundacoes dos predios
    for p in PREDIOS:
        _, _, cx, cy, yaw, L, W, _, _, _ = p
        for _ in range(26):
            lado = rng.choice([-1, 1])
            lx, ly = rng.uniform(-L / 2.0, L / 2.0), lado * (W / 2.0 + rng.uniform(0.6, 2.2))
            x = cx + lx * cos(yaw) - ly * sin(yaw)
            y = cy + lx * sin(yaw) + ly * cos(yaw)
            if dentro(x, y, LIVRE_INICIAL) or any(dentro(x, y, ret_via(v), CAL_L) for v in VIAS):
                continue
            if rng.random() < 0.5:
                instancia("Arbusto", rng.choice(arb), "VEGETACAO", (x, y, alt(x, y)), (0, 0, rng.uniform(0, 6.28)), rng.uniform(0.5, 0.9))
            else:
                instancia("Capim", rng.choice(cap_a), "VEGETACAO", (x, y, alt(x, y)), (0, 0, rng.uniform(0, 6.28)), 1.0)
    return cont


