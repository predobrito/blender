def ret_via(v):
    h = v['l'] / 2.0
    if v['eixo'] == 'x':
        return (v['a'], v['b'], v['c'] - h, v['c'] + h)
    return (v['c'] - h, v['c'] + h, v['a'], v['b'])


def ret_predio(p, margem=0.0):
    _, _, cx, cy, _, L, W, _, _, _ = p
    return (cx - L / 2 - margem, cx + L / 2 + margem, cy - W / 2 - margem, cy + W / 2 + margem)


def expandir(r, m):
    return (r[0] - m, r[1] + m, r[2] - m, r[3] + m)


def dist_ret(x, y, r):
    dx = max(r[0] - x, 0.0, x - r[1])
    dy = max(r[2] - y, 0.0, y - r[3])
    return hypot(dx, dy)


def dentro(x, y, r, m=0.0):
    return r[0] - m <= x <= r[1] + m and r[2] - m <= y <= r[3] + m


def rects_planos():
    L = [expandir(ret_via(v), CAL_L + 0.5) for v in VIAS]
    L.append(PRACA)
    L += [ret_predio(p, 6.0) for p in PREDIOS]
    L += [expandir(RET_USINA, 1.5), RET_RODA, RET_GARAGENS, expandir(RET_GALPOES, 1.5),
          expandir(RET_TORRE_RESF, 1.0), expandir(RET_PATIO1, 1.5), expandir(RET_PATIO2, 1.5)]
    return L


def rects_bloqueio(m):
    """Regioes onde arvores/arbustos nao crescem (margem m)."""
    L = [expandir(ret_via(v), CAL_L + m) for v in VIAS]
    L.append(expandir(LIVRE_INICIAL, 1.0))
    L += [ret_predio(p, 5.5 + m) for p in PREDIOS]
    L += [expandir(r, m) for r in (RET_USINA, RET_RODA, RET_GARAGENS, RET_GALPOES, RET_TORRE_RESF,
                                    RET_PATIO1, RET_PATIO2)]
    return L


def bloqueado(x, y, rects):
    for r in rects:
        if r[0] <= x <= r[1] and r[2] <= y <= r[3]:
            return True
    return False


# ----------------------------------------------------------------------------
# TERRENO (superficie continua com desniveis suaves; plano sob ruas e predios)
# ----------------------------------------------------------------------------
def _suave(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


def ruido(x, y):
    return (0.55 * sin(x * 0.083 + 1.7) * cos(y * 0.071 + 0.6) + 0.30 * sin(x * 0.19 + y * 0.16 + 2.0)
            + 0.14 * sin(x * 0.47 - y * 0.39 + 0.5) + 0.05 * sin(x * 1.3 + y * 1.1))


def micro(x, y):
    return 0.035 * sin(x * 2.9 + y * 1.7) * cos(y * 3.3 - x * 1.1) + 0.02 * sin(x * 6.1 + y * 5.3)


_PLANOS = None


def alt(x, y):
    """Altura do terreno em (x, y)."""
    global _PLANOS
    if _PLANOS is None:
        _PLANOS = rects_planos()
    d = min(dist_ret(x, y, r) for r in _PLANOS)
    s = _suave((d - 0.5) / 8.0)
    z = (0.8 * ruido(x, y) + micro(x, y)) * s
    for (px, py, pr) in BURACOS:
        dd = hypot(x - px, y - py)
        if dd < pr:
            z -= 0.075 * (1.0 - (dd / pr) ** 2)
    return z


def construir_terreno():
    n = int(TAM / PASSO_TERRENO)
    paso = TAM / n
    m = Malha("Terreno")
    bm = m.bm
    V = []
    for j in range(n + 1):
        fila = []
        for i in range(n + 1):
            x = -MET + i * paso
            y = -MET + j * paso
            fila.append(bm.verts.new((x, y, alt(x, y))))
        V.append(fila)
    for j in range(n):
        for i in range(n):
            bm.faces.new((V[j][i], V[j][i + 1], V[j + 1][i + 1], V[j + 1][i]))
    # saia lateral (bloco solido)
    borda = [[V[0][i] for i in range(n + 1)], [V[j][n] for j in range(n + 1)],
             [V[n][i] for i in range(n, -1, -1)], [V[j][0] for j in range(n, -1, -1)]]
    prof = -2.0
    for lado in borda:
        baixo = [bm.verts.new((v.co.x, v.co.y, prof)) for v in lado]
        for k in range(len(lado) - 1):
            bm.faces.new((lado[k], lado[k + 1], baixo[k + 1], baixo[k]))
    bm.faces.new([bm.verts.new((-MET, -MET, prof)), bm.verts.new((-MET, MET, prof)),
                  bm.verts.new((MET, MET, prof)), bm.verts.new((MET, -MET, prof))])
    o = m.objeto("TERRENO", "terra")
    return o


