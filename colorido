# ----------------------------------------------------------------------------
# MALHA ACUMULADORA (varias primitivas em uma unica malha)
# ----------------------------------------------------------------------------
def _ico(tmp, sub, r):
    try:
        bmesh.ops.create_icosphere(tmp, subdivisions=sub, radius=r)
    except TypeError:
        bmesh.ops.create_icosphere(tmp, subdivisions=sub, diameter=r)


class Malha:
    def __init__(self, nome):
        self.nome = nome
        self.bm = bmesh.new()
        self.base = Matrix.Identity(4)
        self.pilha = []

    def push(self, M):
        self.pilha.append(self.base)
        self.base = self.base @ M

    def pop(self):
        self.base = self.pilha.pop()

    def _face(self, vs, idx, suave=False):
        try:
            f = self.bm.faces.new([vs[i] for i in idx])
            f.smooth = suave
        except ValueError:
            pass

    def box(self, c, s, yaw=0.0, rx=0.0, ry=0.0):
        if min(s) < 1e-4:
            return
        hx, hy, hz = s[0] / 2.0, s[1] / 2.0, s[2] / 2.0
        co = [(-hx, -hy, -hz), (hx, -hy, -hz), (hx, hy, -hz), (-hx, hy, -hz),
              (-hx, -hy, hz), (hx, -hy, hz), (hx, hy, hz), (-hx, hy, hz)]
        c = Vector(c)
        if yaw == 0.0 and rx == 0.0 and ry == 0.0:
            vs = [self.bm.verts.new(self.base @ (c + Vector(p))) for p in co]
        else:
            R = Matrix.Rotation(yaw, 4, 'Z') @ Matrix.Rotation(ry, 4, 'Y') @ Matrix.Rotation(rx, 4, 'X')
            vs = [self.bm.verts.new(self.base @ (c + (R @ Vector(p)))) for p in co]
        for f in CUBO_F:
            self._face(vs, f)

    def cil(self, c, r, h, eixo=(0, 0, 1), seg=12, r2=None, tampas=True, suave=True):
        if h < 1e-4:
            return
        r2 = r if r2 is None else r2
        a = Vector(eixo).normalized()
        q = Vector((0, 0, 1)).rotation_difference(a)
        M = self.base @ Matrix.Translation(Vector(c)) @ q.to_matrix().to_4x4()
        hh = h / 2.0
        r0 = [self.bm.verts.new(M @ Vector((r * cos(2 * pi * i / seg), r * sin(2 * pi * i / seg), -hh))) for i in range(seg)]
        r1 = [self.bm.verts.new(M @ Vector((r2 * cos(2 * pi * i / seg), r2 * sin(2 * pi * i / seg), hh))) for i in range(seg)]
        for i in range(seg):
            j = (i + 1) % seg
            self._face(r0 + r1, (i, j, seg + j, seg + i), suave)
        if tampas:
            self._face(r0, list(range(seg))[::-1])
            self._face(r1, list(range(seg)))

    def tubo(self, p1, p2, r, seg=6, r2=None):
        p1, p2 = Vector(p1), Vector(p2)
        d = p2 - p1
        if d.length < 1e-5:
            return
        self.cil((p1 + p2) / 2.0, r, d.length, d, seg=seg, r2=r2, tampas=True, suave=False)

    def barra(self, p1, p2, wy, wz):
        p1, p2 = Vector(p1), Vector(p2)
        d = p2 - p1
        if d.length < 1e-5:
            return
        M = Matrix.Translation((p1 + p2) / 2.0) @ d.to_track_quat('X', 'Z').to_matrix().to_4x4()
        self.push(M)
        self.box((0, 0, 0), (d.length, wy, wz))
        self.pop()

    def prisma(self, pts, w0, w1, plano='XY'):
        """Poligono 2D extrudado. XY: (x,y)->z em [w0,w1]; XZ: (x,z)->y; YZ: (y,z)->x."""
        def P(u, v, w):
            if plano == 'XY':
                return (u, v, w)
            if plano == 'XZ':
                return (u, w, v)
            return (w, u, v)
        a = [self.bm.verts.new(self.base @ Vector(P(u, v, w0))) for u, v in pts]
        b = [self.bm.verts.new(self.base @ Vector(P(u, v, w1))) for u, v in pts]
        n = len(pts)
        vs = a + b
        self._face(vs, list(range(n))[::-1])
        self._face(vs, list(range(n, 2 * n)))
        for i in range(n):
            j = (i + 1) % n
            self._face(vs, (i, j, n + j, n + i))

    def esfera(self, c, r, esc=(1, 1, 1), jit=0.0, rng=None, sub=1):
        tmp = bmesh.new()
        _ico(tmp, sub, r)
        c = Vector(c)
        mp = {}
        for v in tmp.verts:
            p = Vector((v.co.x * esc[0], v.co.y * esc[1], v.co.z * esc[2]))
            if jit and rng:
                p *= 1.0 + rng.uniform(-jit, jit)
            mp[v] = self.bm.verts.new(self.base @ (c + p))
        for f in tmp.faces:
            self._face([mp[v] for v in f.verts], range(len(f.verts)))
        tmp.free()

    def lamina(self, pts):
        vs = [self.bm.verts.new(self.base @ Vector(p)) for p in pts]
        n = len(vs)
        self._face(vs, range(n))
        self._face(vs, list(range(n))[::-1])

    def toro(self, c, R, r, eixo=(0, 0, 1), maj=24, mi=6):
        a = Vector(eixo).normalized()
        q = Vector((0, 0, 1)).rotation_difference(a)
        M = self.base @ Matrix.Translation(Vector(c)) @ q.to_matrix().to_4x4()
        vs = []
        for i in range(maj):
            t = 2 * pi * i / maj
            for j in range(mi):
                b = 2 * pi * j / mi
                rr = R + r * cos(b)
                vs.append(self.bm.verts.new(M @ Vector((rr * cos(t), rr * sin(t), r * sin(b)))))
        for i in range(maj):
            for j in range(mi):
                i2, j2 = (i + 1) % maj, (j + 1) % mi
                self._face(vs, (i * mi + j, i2 * mi + j, i2 * mi + j2, i * mi + j2), True)

    def cabo(self, pts, r, seg=6, juntas=False):
        pts = [Vector(p) for p in pts]
        for a, b in zip(pts[:-1], pts[1:]):
            self.tubo(a, b, r, seg)
        if juntas:
            for i in range(1, len(pts) - 1):
                self.cil(pts[i], r * 1.15, r * 2.2, pts[i + 1] - pts[i - 1], seg=seg, tampas=False)

    def lathe(self, perfil, seg=28, esp=0.3, fechar_topo=True):
        """Casca de revolucao (perfil = [(raio, z)...]) com espessura (face externa + interna)."""
        n = len(perfil)
        ext, inn = [], []
        for (r, z) in perfil:
            ext.append([self.bm.verts.new(self.base @ Vector((r * cos(2 * pi * i / seg), r * sin(2 * pi * i / seg), z))) for i in range(seg)])
            ri = max(r - esp, 0.05)
            inn.append([self.bm.verts.new(self.base @ Vector((ri * cos(2 * pi * i / seg), ri * sin(2 * pi * i / seg), z))) for i in range(seg)])
        for k in range(n - 1):
            for i in range(seg):
                j = (i + 1) % seg
                f = self.bm.faces.new((ext[k][i], ext[k][j], ext[k + 1][j], ext[k + 1][i]))
                f.smooth = True
                f = self.bm.faces.new((inn[k][j], inn[k][i], inn[k + 1][i], inn[k + 1][j]))
                f.smooth = True
        if fechar_topo:
            for i in range(seg):
                j = (i + 1) % seg
                self.bm.faces.new((ext[-1][i], inn[-1][i], inn[-1][j], ext[-1][j]))
        for i in range(seg):
            j = (i + 1) % seg
            self.bm.faces.new((ext[0][j], inn[0][j], inn[0][i], ext[0][i]))

    def mesh(self, mat, bevel=0.0):
        me = bpy.data.meshes.new(self.nome)
        bmesh.ops.recalc_face_normals(self.bm, faces=self.bm.faces[:])
        self.bm.to_mesh(me)
        self.bm.free()
        me.materials.append(MATS[mat])
        return bake_bevel(me, bevel) if bevel > 0 else me

    def objeto(self, col, mat, bevel=0.0):
        me = self.mesh(mat, bevel)
        o = bpy.data.objects.new(self.nome, me)
        COL[col].objects.link(o)
        return o


def bake_bevel(mesh, larg, ang=radians(35)):
    """Aplica um bevel (chanfro) diretamente na malha, para poder compartilhar a geometria."""
    if len(mesh.polygons) == 0:
        return mesh
    try:
        nome = mesh.name
        tmp = bpy.data.objects.new("_tmp_bevel", mesh)
        bpy.context.scene.collection.objects.link(tmp)
        md = tmp.modifiers.new("b", 'BEVEL')
        md.width = larg
        md.segments = 1
        md.limit_method = 'ANGLE'
        md.angle_limit = ang
        bpy.context.view_layer.update()
        dg = bpy.context.evaluated_depsgraph_get()
        novo = bpy.data.meshes.new_from_object(tmp.evaluated_get(dg))
        bpy.data.objects.remove(tmp, do_unlink=True)
        bpy.data.meshes.remove(mesh)
        novo.name = nome
        return novo
    except Exception as ex:
        print("bevel ignorado:", ex)
        return mesh


def instancia(nome, mesh, col, loc, rot=(0, 0, 0), esc=1.0):
    o = bpy.data.objects.new(nome, mesh)
    o.location = loc
    o.rotation_euler = rot
    o.scale = (esc, esc, esc) if not isinstance(esc, (tuple, list)) else esc
    COL[col].objects.link(o)
    return o


