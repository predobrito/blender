    m.box((0, 0, 0.62), (L, W, 0.6))
    m.box((-0.2, 0, 1.45), (L - 0.9, W - 0.05, 1.2))
    m.box((1.75, 0, 1.0), (0.8, W - 0.05, 0.9))
    m.box((1.95, 0, 1.15), (0.1, W - 0.3, 0.5), ry=0.0)
    for sy in (-1, 1):
        for k in range(3):
            m.box((-0.9 + k * 1.0, sy * (W / 2.0 - 0.02), 1.6), (0.7, 0.04, 0.5))
        m.box((0.4, sy * (W / 2.0 + 0.02), 1.1), (0.04, 0.04, 1.0))
        far(m, (2.14, sy * 0.6, 0.75))
    m.box((-2.2, 0, 0.6), (0.1, W, 0.9))
    m.box((2.25, 0, 0.42), (0.14, W + 0.1, 0.2))
    m.box((-2.25, 0, 0.42), (0.14, W + 0.1, 0.2))
    m.box((-0.2, 0, 2.08), (L - 1.2, W - 0.3, 0.07))
