# RUAS E CALCADAS (lajes individuais com frestas, buracos e lajes levantadas)
# ----------------------------------------------------------------------------
def subtrair(a, b, cortes):
    segs = [(a, b)]
    for c0, c1 in cortes:
        novo = []
        for s0, s1 in segs:
            if c1 <= s0 or c0 >= s1:
                novo.append((s0, s1))
                continue
            if c0 > s0:
                novo.append((s0, c0))
            if c1 < s1:
                novo.append((c1, s1))
        segs = novo
    return segs


def laje(m, cx, cy, sx, sy, ztop, esp, rng, diag, levant, gap):
    zc = ztop + rng.uniform(-0.010, 0.010) - esp / 2.0
    a = sx / 2.0 - gap / 2.0
    b = sy / 2.0 - gap / 2.0
    if diag:
        sg = 1 if rng.random() < 0.5 else -1
        t1 = [(-a, -b), (a, -b), (a, b)] if sg > 0 else [(-a, -b), (a, -b), (-a, b)]
        t2 = [(-a, -b), (a, b), (-a, b)] if sg > 0 else [(a, -b), (a, b), (-a, b)]
        for t in (t1, t2):
            gx = sum(p[0] for p in t) / 3.0
            gy = sum(p[1] for p in t) / 3.0
            pts = [(cx + gx + (p[0] - gx) * 0.96, cy + gy + (p[1] - gy) * 0.96) for p in t]
            m.prisma(pts, zc - esp / 2.0 + rng.uniform(-0.008, 0.008), zc + esp / 2.0 + rng.uniform(-0.008, 0.008))
    elif levant:
        ang = rng.uniform(0.02, 0.055) * (1 if rng.random() < 0.5 else -1)
        if rng.random() < 0.5:
            m.box((cx, cy, zc + abs(ang) * a * 0.7), (2 * a, 2 * b, esp), ry=ang)
        else:
            m.box((cx, cy, zc + abs(ang) * b * 0.7), (2 * a, 2 * b, esp), rx=ang)
    else:
        m.box((cx, cy, zc), (2 * a, 2 * b, esp))


def lajes(m, rect, tw, th, ztop, esp, rng, p_falta=0.0, p_diag=0.15, p_levant=0.07,
          gap=0.06, buracos=None, protegido=None):
    x0, x1, y0, y1 = rect
    if x1 - x0 < 0.3 or y1 - y0 < 0.3:
        return
    nx = max(1, int(round((x1 - x0) / tw)))
    ny = max(1, int(round((y1 - y0) / th)))
    sx, sy = (x1 - x0) / nx, (y1 - y0) / ny
    for i in range(nx):
        for j in range(ny):
            cx = x0 + (i + 0.5) * sx
            cy = y0 + (j + 0.5) * sy
            prot = protegido is not None and dentro(cx, cy, protegido, 2.5)
            r = rng.random()
            if not prot and r < p_falta:
                if buracos is not None:
                    buracos.append((cx, cy, min(sx, sy) * 0.62))
                continue
            laje(m, cx, cy, sx, sy, ztop, esp, rng, rng.random() < p_diag, (not prot) and rng.random() < p_levant, gap)


def construir_ruas():
    rng = random.Random(SEED + 1)
    mats = {"asfalto": Malha("Ruas_Asfalto"), "concreto": Malha("Ruas_Concreto")}
    cal = Malha("Calcadas_e_Meios_Fios")
    xs = [v for v in VIAS if v['eixo'] == 'x']
    ys = [v for v in VIAS if v['eixo'] == 'y']
    prot = LIVRE_INICIAL
    for v in VIAS:
        m = mats[v['mat']]
        h = v['l'] / 2.0
        t = v['tile']
        pf = 0.05 if v['mat'] == 'asfalto' else 0.04
        if v['eixo'] == 'x':
            lajes(m, ret_via(v), t, t, Z_VIA, ESP_LAJE_, rng, pf, 0.15, 0.06, 0.06, BURACOS, prot)
        else:
            segs = subtrair(v['a'], v['b'], [(x['c'] - x['l'] / 2, x['c'] + x['l'] / 2) for x in xs])
            for (s0, s1) in segs:
                lajes(m, (v['c'] - h, v['c'] + h, s0, s1), t, t, Z_VIA, ESP_LAJE_, rng, pf, 0.15, 0.06, 0.06, BURACOS, prot)
    # calcadas + meios-fios
    for v in VIAS:
        h = v['l'] / 2.0
        c = v['c']
        if v['eixo'] == 'x':
            cortes = [(y['c'] - y['l'] / 2, y['c'] + y['l'] / 2) for y in ys if y['a'] <= c <= y['b']]
            if abs(c) < 5.0:
                cortes.append((PRACA[0], PRACA[1]))
            segs = subtrair(v['a'], v['b'], cortes)
            for sg in (-1, 1):
                ye = c + sg * h
                y0, y1 = (ye, ye + CAL_L) if sg > 0 else (ye - CAL_L, ye)
                for (s0, s1) in segs:
                    lajes(cal, (s0, s1, y0, y1), 2.0, CAL_L / 2.0, Z_CAL, 0.22, rng, 0.07, 0.12, 0.10, 0.05)
                    meio_fio(cal, rng, 'x', s0, s1, ye + sg * 0.075)
        else:
            cortes = [(x['c'] - x['l'] / 2 - CAL_L, x['c'] + x['l'] / 2 + CAL_L) for x in xs]
            segs = subtrair(v['a'], v['b'], cortes)
            for sg in (-1, 1):
                xe = c + sg * h
                x0, x1 = (xe, xe + CAL_L) if sg > 0 else (xe - CAL_L, xe)
                for (s0, s1) in segs:
                    lajes(cal, (x0, x1, s0, s1), CAL_L / 2.0, 2.0, Z_CAL, 0.22, rng, 0.07, 0.12, 0.10, 0.05)
                    meio_fio(cal, rng, 'y', s0, s1, xe + sg * 0.075)
    # praca inicial (16 x 16 m, plana e livre)
    for (rr) in ((PRACA[0], PRACA[1], 4.0, PRACA[3]), (PRACA[0], PRACA[1], PRACA[2], -4.0)):
        lajes(cal, rr, 2.0, 2.0, Z_VIA, ESP_LAJE_, rng, 0.0, 0.10, 0.0, 0.06)
    for k, m in mats.items():
        m.objeto("RUAS_E_CALCADAS", k, 0.012)
    cal.objeto("RUAS_E_CALCADAS", "concreto", 0.012)


ESP_LAJE_ = 0.30


def meio_fio(m, rng, eixo, s0, s1, pos):
    seg = 5.0
    n = max(1, int(round((s1 - s0) / seg)))
    L = (s1 - s0) / n
    for i in range(n):
        if rng.random() < 0.08:
            continue
        u = s0 + (i + 0.5) * L
        if eixo == 'x':
            m.box((u, pos, Z_CAL + 0.01 - 0.12), (L - 0.04, 0.15, 0.26))
        else:
            m.box((pos, u, Z_CAL + 0.01 - 0.12), (0.15, L - 0.04, 0.26))


