    for (tx, ty) in ((24.0, 57.0), (72.0, 47.5)):
        torre_trelica(k, tx, ty, 32.0 if tx < 30 else 26.0, 3.0, 1.0, 10)
    guindaste(k, 47.0, 66.0, 38.0, 20.0, rng)
    # estrutura metalica com passarela entre o bloco e a sala de turbinas
    k.box((37.0, 61.8, 13.5), (18.0, 1.2, 0.2))
    k.objeto("USINA_NUCLEAR", "usina", 0.04)


