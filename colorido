def galpao(m, rng, cx, cy, sx, sy, h, nbaias, rotulo=""):
    """Galpao industrial de estrutura metalica com paineis (alguns faltando)."""
    bw = sx / nbaias
    for i in range(nbaias + 1):
        x = cx - sx / 2.0 + i * bw
        for sg in (-1, 1):
            m.box((x, cy + sg * sy / 2.0, h / 2.0), (0.4, 0.4, h))
        m.barra((x, cy - sy / 2.0, h), (x, cy, h + 1.6), 0.3, 0.3)
        m.barra((x, cy + sy / 2.0, h), (x, cy, h + 1.6), 0.3, 0.3)
        m.barra((x, cy - sy / 2.0, h), (x, cy + sy / 2.0, h), 0.25, 0.25)
        m.barra((x, cy - sy / 4.0, h + 0.8), (x, cy, h + 0.1), 0.15, 0.15)
        m.barra((x, cy + sy / 4.0, h + 0.8), (x, cy, h + 0.1), 0.15, 0.15)
    m.box((cx, cy, 0.2), (sx, sy, 0.4))
    for sg in (-1, 1):
        m.box((cx, cy + sg * sy / 2.0, 1.6), (sx, 0.3, 3.2))              # soco de concreto
        for i in range(nbaias):
            for k in range(3):
                if rng.random() < 0.12:
                    continue
                x = cx - sx / 2.0 + (i + 0.5) * bw
                m.box((x, cy + sg * sy / 2.0, 3.6 + k * (h - 3.4) / 3.0 + (h - 3.4) / 6.0),
                      (bw - 0.12, 0.08, (h - 3.4) / 3.0 - 0.1))
        for q in range(2):
            m.box((cx, cy + sg * (sy / 2.0 - q * 0.0), h + 0.8 + 0.4 * (1 - q)), (sx, 0.05, 0.2)) if False else None
    for sg in (-1, 1):                                                     # telhado em duas aguas
        for i in range(nbaias):
            if rng.random() < 0.10:
                continue
            x = cx - sx / 2.0 + (i + 0.5) * bw
            m.box((x, cy + sg * sy / 4.0, h + 0.9), (bw - 0.1, sy / 2.0 + 0.2, 0.08), rx=sg * 0.2)
    for sg in (-1, 1):
        m.box((cx - sx / 2.0, cy + sg * 0.0, h / 2.0 + 1.0), (0.2, sy, h + 2.0)) if False else None
    m.box((cx - sx / 2.0, cy, h / 2.0 + 0.5), (0.3, sy, h + 1.0))
    # portao grande de correr (aberto) + lampadas externas
    m.box((cx + sx / 2.0, cy, 2.6), (0.3, 4.6, 5.2))
    m.box((cx + sx / 2.0 + 0.2, cy - 2.4, 2.4), (0.08, 3.4, 4.8))
    for i in range(0, nbaias, 2):
        x = cx - sx / 2.0 + (i + 0.5) * bw
        m.cil((x, cy - sy / 2.0 - 0.3, 3.4), 0.12, 0.3, (0, 1, 0), seg=8)


def plano_arco(m, cx, cy, comp, vao, alt, nx=12, na=18):
    """Casca de arco (contencao) com nervuras. Eixo longitudinal = X."""
    pts = [(vao / 2.0 * cos(pi * k / na), alt * sin(pi * k / na)) for k in range(na + 1)]
    pts = [(-vao / 2.0 * cos(pi * k / na) * -1.0, z) for k, (_, z) in enumerate(pts)]
    anel = []
    for i in range(nx + 1):
        x = cx - comp / 2.0 + i * comp / nx
        anel.append([m.bm.verts.new(m.base @ Vector((x, cy + yy, z))) for (yy, z) in pts])
    for i in range(nx):
        for k in range(na):
            for esp, off in ((0, 0.0),):
                m._face(anel[i] + anel[i + 1], (k, k + 1, na + 1 + k + 1, na + 1 + k))
    # nervuras e treliças
    for i in range(nx + 1):
        x = cx - comp / 2.0 + i * comp / nx
        for k in range(na):
            m.barra((x, cy + pts[k][0], pts[k][1] + 0.02), (x, cy + pts[k + 1][0], pts[k + 1][1] + 0.02), 0.35, 0.5)
            m.barra((x, cy + pts[k][0] * 0.94, pts[k][1] * 0.94 - 0.4), (x, cy + pts[k + 1][0] * 0.94, pts[k + 1][1] * 0.94 - 0.4), 0.18, 0.18)
            if k % 2 == 0:
                m.barra((x, cy + pts[k][0], pts[k][1]), (x, cy + pts[k + 1][0] * 0.94, pts[k + 1][1] * 0.94 - 0.4), 0.12, 0.12)
    for k in range(0, na + 1, 3):
        m.barra((cx - comp / 2.0, cy + pts[k][0], pts[k][1] + 0.3), (cx + comp / 2.0, cy + pts[k][0], pts[k][1] + 0.3), 0.25, 0.25)


def torre_trelica(m, x, y, h, wb, wt, secoes, r=0.07):
    for k in range(secoes):
        z0, z1 = h * k / secoes, h * (k + 1) / secoes
        w0 = wb + (wt - wb) * k / secoes
        w1 = wb + (wt - wb) * (k + 1) / secoes
        for sx in (-1, 1):
            for sy in (-1, 1):
                m.tubo((x + sx * w0 / 2, y + sy * w0 / 2, z0), (x + sx * w1 / 2, y + sy * w1 / 2, z1), r, 6)
        for sg in (-1, 1):
            m.tubo((x - w0 / 2, y + sg * w0 / 2, z0), (x + w1 / 2, y + sg * w1 / 2, z1), r * 0.55, 5)
            m.tubo((x + sg * w0 / 2, y - w0 / 2, z0), (x + sg * w1 / 2, y + w1 / 2, z1), r * 0.55, 5)
        m.tubo((x - w1 / 2, y - w1 / 2, z1), (x + w1 / 2, y - w1 / 2, z1), r * 0.5, 5)
        m.tubo((x - w1 / 2, y + w1 / 2, z1), (x + w1 / 2, y + w1 / 2, z1), r * 0.5, 5)
        m.tubo((x - w1 / 2, y - w1 / 2, z1), (x - w1 / 2, y + w1 / 2, z1), r * 0.5, 5)
        m.tubo((x + w1 / 2, y - w1 / 2, z1), (x + w1 / 2, y + w1 / 2, z1), r * 0.5, 5)


def tanque(m, x, y, r, h):
    m.cil((x, y, h / 2.0), r, h, seg=24)
    for k in range(1, 4):
        m.cil((x, y, h * k / 4.0), r * 1.02, 0.12, seg=24)
    m.cil((x, y, h + 0.35), r * 0.55, 0.7, seg=24, r2=r * 0.2)
    m.cil((x, y, 0.2), r * 1.12, 0.4, seg=24)
    # escada helicoidal simplificada e passarela
    for k in range(10):
        a = 0.4 + k * 0.28
        m.box((x + cos(a) * (r + 0.35), y + sin(a) * (r + 0.35), 0.4 + k * h / 11.0),
              (0.7, 0.45, 0.06), yaw=a + pi / 2)
    m.tubo((x + r * 0.9, y, h + 0.1), (x + r * 3.0, y, h * 0.55), 0.10, 8)


def guindaste(m, x, y, h, jib, rng):
    torre_trelica(m, x, y, h, 1.8, 1.4, 12, 0.07)
    m.box((x, y, h + 0.7), (1.8, 1.8, 1.4))                      # cabine
    m.box((x + 0.95, y, h + 0.9), (0.15, 1.2, 0.8))
    m.barra((x - 7.0, y, h + 1.5), (x + jib, y, h + 1.5), 0.6, 0.6)
    for k in range(6):
        xx = x - 7.0 + k * (jib + 7.0) / 5.0
        m.barra((xx, y, h + 1.5), (xx, y, h + 4.0), 0.1, 0.1)
    m.tubo((x, y, h + 4.8), (x - 7.0, y, h + 1.6), 0.04, 5)
    m.tubo((x, y, h + 4.8), (x + jib, y, h + 1.6), 0.04, 5)
    m.box((x - 6.0, y, h + 0.9), (2.0, 1.6, 1.4))                # contrapeso
    m.tubo((x + jib * 0.8, y, h + 1.0), (x + jib * 0.8, y, h - 12.0), 0.02, 4)
    m.box((x + jib * 0.8, y, h - 12.4), (0.5, 0.3, 0.8))


