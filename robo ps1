# CONSTANTES GLOBAIS
# ----------------------------------------------------------------------------
NOMES_COLECOES = ["CHASSI", "ESTEIRAS", "TORRE_DE_SENSORES", "BRACO_ROBOTICO",
                  "ANTENAS_E_EQUIPAMENTOS", "DETALHES"]
COL = {}
MAT = None
MAT_CHAO = None
PAR = None    # parafusos e rebites
CAB = None    # cabos e mangueiras
VENT = None   # grades de ventilação e painéis

# Esteiras
ZC = 0.19          # altura do centro das rodas
LU = 0.27          # distância entre eixos de cada conjunto
RP = 0.17          # raio da linha de centro das placas da esteira
PERIM = 2 * LU + 2 * pi * RP
N_SEG = int(round(PERIM / 0.075))
PITCH = PERIM / N_SEG
CY = 0.34          # posição lateral do centro das esteiras
LARG_E = 0.13      # largura da esteira

TOPO = 0.58        # altura do topo do chassi (onde assentam torre e braço)
X0 = 0.10          # posição X da torre de sensores


