def malha_segmento():
    """Um elo de esteira: placa, garra, trilhos laterais, dente-guia e pino."""
    p = Peca("Elo_Esteira", "ESTEIRAS")
    w = PITCH
    p.caixa((w * 0.94, LARG_E, 0.016), (0, 0, 0), 0.0)
    p.caixa((w * 0.55, LARG_E - 0.012, 0.014), (0, 0, 0.014), 0.0)
    return p.malha()


def ponto_caminho(s, x1, x2):
    s %= PERIM
    if s < LU:
        return (x1 + s, ZC + RP, 1.0, 0.0)
    s -= LU
    arc = pi * RP
    if s < arc:
        phi = pi / 2 - s / RP
        return (x2 + RP * cos(phi), ZC + RP * sin(phi), sin(phi), -cos(phi))
    s -= arc
    if s < LU:
        return (x2 - s, ZC - RP, -1.0, 0.0)
    s -= LU
    phi = -pi / 2 - s / RP
    return (x1 + RP * cos(phi), ZC + RP * sin(phi), sin(phi), -cos(phi))


def construir_esteira(nome, cx, lado, malha_seg):
    cy = lado * CY
    x1, x2 = cx - LU / 2, cx + LU / 2

    # 1) correia: elos individuais (instâncias da mesma malha)
    for i in range(N_SEG):
        s = (i + 0.5) * PITCH
        x, z, tx, tz = ponto_caminho(s, x1, x2)
        beta = -atan2(tz, tx)
        M = Matrix.Translation((x, cy, z)) @ Matrix.Rotation(beta, 4, 'Y')
        o = bpy.data.objects.new("%s_elo%02d" % (nome, i), malha_seg)
        o.matrix_world = M
        COL["ESTEIRAS"].objects.link(o)

    # 2) rodas, eixos e roletes
    p = Peca(nome + "_Rodas", "ESTEIRAS")
    x_dentada = x1 if cx > 0 else x2
    x_tensora = x2 if cx > 0 else x1
    Y = (0, 1, 0)

    # roda dentada (sprocket)
    c = Vector((x_dentada, cy, ZC))
    p.cil(0.100, 0.042, c, Y, seg=32)
    for s in (-1, 1):
        p.cil(0.125, 0.018, c + Vector((0, s * 0.036, 0)), Y, seg=40, bisel=0.002)
    n_d = 8
    for k in range(n_d):
        a = 2 * pi * k / n_d
        pos = c + Vector((cos(a) * 0.135, 0, sin(a) * 0.135))
        M = M_trans(pos) @ Matrix.Rotation(-a, 4, 'Y')
        p.caixa((0.026, 0.030, 0.017), None, 0.002, M)
    p.cil(0.040, 0.100, c, Y, seg=20)

    # roda tensora (idler) com raios e aro
    c = Vector((x_tensora, cy, ZC))
    for s in (-1, 1):
        p.cil(0.133, 0.016, c + Vector((0, s * 0.037, 0)), Y, seg=40, bisel=0.002)
    p.cil(0.095, 0.050, c, Y, seg=32)
    for k in range(6):
        a = 2 * pi * k / 6 + pi / 6
        pos = c + Vector((cos(a) * 0.075, 0, sin(a) * 0.075))
        M = M_trans(pos) @ Matrix.Rotation(-a, 4, 'Y')
        p.caixa((0.060, 0.080, 0.014), None, 0.002, M)
    p.cil(0.040, 0.100, c, Y, seg=20)

    # roletes internos de sustentação e rolete superior
    p.cil(0.035, 0.075, (cx, cy, ZC - 0.127), Y, seg=20)
    p.cil(0.016, 0.100, (cx, cy, ZC - 0.127), Y, seg=12)
    p.cil(0.020, 0.062, (cx, cy, ZC + 0.140), Y, seg=16)
    p.barra((cx, cy - lado * 0.045, ZC - 0.127), (x_dentada, cy - lado * 0.045, ZC), 0.012, 0.012)

    # eixos
    for xw in (x1, x2):
        p.cil(0.020, 0.185, (xw, lado * 0.3575, ZC), Y, seg=16)
    p.concluir()

    # 3) proteção lateral articulada (placa externa)
    q = Peca(nome + "_Protecao", "ESTEIRAS")
    y0, y1 = lado * 0.407, lado * 0.429
    q.prisma(estadio(x1, x2, ZC, 0.105), y0, y1, 'XZ', 0.004)
    q.prisma(estadio(x1, x2, ZC, 0.082), y1, lado * 0.434, 'XZ', 0.003)
    q.caixa((LU * 0.9, 0.008, 0.050), (cx, lado * 0.4375, ZC), 0.002)
    for xw in (x1, x2):
        q.cil(0.050, 0.020, (xw, lado * 0.444, ZC), Y, seg=28, bisel=0.003)
        q.cil(0.020, 0.010, (xw, lado * 0.455, ZC), Y, seg=16, bisel=0.002)
        anel_parafusos((xw, lado * 0.451, ZC), 0.034, 6, (0, lado, 0), r=0.0045, h=0.005)
    # parafusos da placa
    for dx in (-0.08, 0.0, 0.08):
        PAR.cil(0.005, 0.005, (cx + dx, lado * 0.4385, ZC + 0.035), (0, lado, 0), seg=6, bisel=0)
        PAR.cil(0.005, 0.005, (cx + dx, lado * 0.4385, ZC - 0.035), (0, lado, 0), seg=6, bisel=0)
    q.concluir()


