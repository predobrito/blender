def construir_chassi():
    p = Peca("Chassi_Casco", "CHASSI")

    # casco inferior (entre as esteiras)
    inf = [(-0.50, -0.20), (-0.40, -0.26), (0.40, -0.26), (0.50, -0.18),
           (0.50, 0.18), (0.40, 0.26), (-0.40, 0.26), (-0.50, 0.20)]
    p.prisma(inf, 0.14, 0.40, 'XY', 0.006)
    # casco superior (sobre as esteiras)
    sup = [(-0.46, -0.30), (-0.36, -0.37), (0.40, -0.37), (0.54, -0.27),
           (0.54, 0.27), (0.40, 0.37), (-0.36, 0.37), (-0.46, 0.30)]
    p.prisma(sup, 0.40, 0.52, 'XY', 0.006)
    # cabine superior
    cab = [(-0.42, -0.22), (-0.34, -0.27), (0.30, -0.27), (0.40, -0.19),
           (0.40, 0.19), (0.30, 0.27), (-0.34, 0.27), (-0.42, 0.22)]
    p.prisma(cab, 0.52, TOPO, 'XY', 0.005)

    # placas de proteção sobrepostas (laterais)
    for lado in (1, -1):
        y = lado * 0.374
        # painel de manutenção
        p.caixa((0.22, 0.014, 0.085), (-0.01, y, 0.46), 0.003)
        p.caixa((0.15, 0.008, 0.050), (-0.01, lado * 0.382, 0.46), 0.002)
        parafusos_retangulo((-0.01, lado * 0.386, 0.46), 0.19, 0.070, (0, lado, 0))
        # grade de ventilação
        VENT.caixa((0.18, 0.012, 0.095), (0.22, lado * 0.372, 0.46), 0.002)
        for i in range(6):
            VENT.caixa((0.15, 0.010, 0.0075), (0.22, lado * 0.380, 0.425 + i * 0.0145), 0.0015)
        # compartimento lateral de equipamentos
        p.caixa((0.20, 0.030, 0.090), (-0.22, lado * 0.385, 0.46), 0.004)
        p.caixa((0.17, 0.010, 0.070), (-0.22, lado * 0.403, 0.46), 0.002)
        p.cil(0.011, 0.014, (-0.31 + 0.0, lado * 0.408, 0.46), (0, lado, 0), seg=16)
        parafusos_retangulo((-0.22, lado * 0.409, 0.46), 0.15, 0.060, (0, lado, 0))
        # alça metálica
        cabo(CAB, [(-0.22 + 0.04, lado * 0.404, 0.435), (-0.22 + 0.04, lado * 0.428, 0.435),
                   (-0.22 + 0.04, lado * 0.428, 0.485), (-0.22 + 0.04, lado * 0.404, 0.485)], 0.007)
        # painéis do casco inferior (vão entre esteiras)
        p.caixa((0.08, 0.012, 0.14), (0.0, lado * 0.264, 0.27), 0.003)
        for i in range(4):
            VENT.caixa((0.06, 0.008, 0.008), (0.0, lado * 0.272, 0.22 + i * 0.03), 0.0015)
        # olhais de içamento
        for xx in (0.30, -0.30):
            p.cil(0.018, 0.016, (xx, lado * 0.20, TOPO + 0.008), (0, 0, 1), seg=16)
            p.toro(0.024, 0.0055, (xx, lado * 0.20, TOPO + 0.036), (0, 1, 0))
        # faróis frontais
        p.caixa((0.06, 0.12, 0.11), (0.50, lado * 0.32, 0.46), 0.005)
        for dy in (-1, 1):
            for dz in (-1, 1):
                lente(p, (0.53, lado * 0.32 + dy * 0.027, 0.46 + dz * 0.027), 0.017, (1, 0, 0), 0.012)
        parafusos_retangulo((0.53, lado * 0.32, 0.46), 0.108, 0.098, (1, 0, 0), r=0.004, alt=0.004)

    # placas frontais e para-choque
    p.caixa((0.04, 0.36, 0.20), (0.52, 0, 0.27), 0.006)
    p.caixa((0.014, 0.24, 0.10), (0.546, 0, 0.29), 0.003)
    parafusos_retangulo((0.555, 0, 0.29), 0.22, 0.085, (1, 0, 0))
    p.caixa((0.03, 0.30, 0.08), (0.555, 0, 0.46), 0.004)
    p.caixa((0.012, 0.20, 0.045), (0.572, 0, 0.46), 0.002)
    parafusos_retangulo((0.58, 0, 0.46), 0.185, 0.035, (1, 0, 0), r=0.0045, alt=0.005)
    cabo(CAB, [(0.52, -0.20, 0.17), (0.64, -0.20, 0.17), (0.64, 0.20, 0.17), (0.52, 0.20, 0.17)], 0.014)
    for s in (-1, 1):
        cabo(CAB, [(0.64, s * 0.20, 0.17), (0.64, s * 0.20, 0.25), (0.545, s * 0.20, 0.30)], 0.011)
    p.caixa((0.10, 0.28, 0.025), (0.575, 0, 0.145), 0.004)
