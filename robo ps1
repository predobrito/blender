def antena(p, x, y, altura, r_mastro=0.0075):
    p.cil(0.022, 0.03, (x, y, TOPO + 0.015), seg=20)
    p.cil(0.016, 0.04, (x, y, TOPO + 0.05), seg=20)
    anel_parafusos((x, y, TOPO + 0.032), 0.019, 5, (0, 0, 1), r=0.003, h=0.004)
    for k in range(0):                                  # mola de base
        p.cil(0.013, 0.006, (x, y, TOPO + 0.078 + k * 0.009), seg=14, bisel=0)
    z0 = TOPO + 0.10
    p.tubo((x, y, z0), (x, y, z0 + altura), r_mastro, seg=12, r2=0.0025)
    p.cil(0.012, 0.02, (x, y, z0 + 0.01), seg=14)
    p.cil(0.0045, 0.014, (x, y, z0 + altura + 0.005), seg=10, bisel=0)


def construir_antenas_equipamentos():
