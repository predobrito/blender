def limpar_cena():
    for o in list(bpy.data.objects):
        bpy.data.objects.remove(o, do_unlink=True)
    for c in list(bpy.data.collections):
        bpy.data.collections.remove(c)
    for m in list(bpy.data.meshes):
        if m.users == 0:
            bpy.data.meshes.remove(m)


def criar_colecoes():
    for n in NOMES_COLECOES:
        c = bpy.data.collections.new(n)
        bpy.context.scene.collection.children.link(c)
        COL[n] = c


def criar_materiais():
    global MAT, MAT_CHAO
    MAT = bpy.data.materials.new("CLAY_CINZA_CLARO")
    MAT.use_nodes = True
    MAT.diffuse_color = (0.62, 0.62, 0.62, 1)
    b = MAT.node_tree.nodes.get("Principled BSDF")
    if b:
        b.inputs["Base Color"].default_value = (0.62, 0.62, 0.62, 1)
        b.inputs["Roughness"].default_value = 0.62
        b.inputs["Metallic"].default_value = 0.0
    MAT_CHAO = bpy.data.materials.new("CHAO_ESCURO")
    MAT_CHAO.use_nodes = True
    MAT_CHAO.diffuse_color = (0.05, 0.05, 0.055, 1)
    b = MAT_CHAO.node_tree.nodes.get("Principled BSDF")
    if b:
        b.inputs["Base Color"].default_value = (0.05, 0.05, 0.055, 1)
        b.inputs["Roughness"].default_value = 0.9


def M_trans(loc):
    return Matrix.Translation(Vector(loc))


def M_eixo(loc, d):
    """Translada para loc e alinha o eixo Z local com a direção d."""
    d = Vector(d).normalized()
    q = Vector((0, 0, 1)).rotation_difference(d)
    return M_trans(loc) @ q.to_matrix().to_4x4()


class Peca:
    """Acumula várias primitivas (com bevel) em uma única malha."""

    def __init__(self, nome, colecao):
        self.nome = nome
        self.col = COL[colecao]
        self.bm = bmesh.new()

    # -- mescla uma malha temporária na malha principal
    def _merge(self, tmp, M):
        bmesh.ops.transform(tmp, matrix=M, verts=tmp.verts[:])
        vm = {}
        for v in tmp.verts:
            vm[v] = self.bm.verts.new(v.co)
        for f in tmp.faces:
            try:
                nf = self.bm.faces.new([vm[v] for v in f.verts])
                nf.smooth = f.smooth
            except ValueError:
                pass
        tmp.free()

    @staticmethod
    def _bisel(tmp, edges, b, lim):
        return   # PS1: sem bevel
        b = min(b, lim * 0.3)
        if b <= 1e-4 or not edges:
            return
        try:
            bmesh.ops.bevel(tmp, geom=edges, offset=b, segments=1,
                            affect='EDGES', clamp_overlap=True)
        except Exception:
            pass

    # -- caixa com bordas chanfradas
    def caixa(self, size, loc=None, bisel=0.004, M=None):
        tmp = bmesh.new()
        bmesh.ops.create_cube(tmp, size=1.0)
        for v in tmp.verts:
            v.co.x *= size[0]
            v.co.y *= size[1]
            v.co.z *= size[2]
        self._bisel(tmp, tmp.edges[:], bisel, min(size))
        self._merge(tmp, M if M is not None else M_trans(loc))

    # -- cilindro / cone, orientado por d (eixo)
    def cil(self, r, prof, loc, d=(0, 0, 1), r2=None, seg=24, bisel=0.003):
        seg = max(6, seg // 3)   # PS1: poucos lados
        tmp = bmesh.new()
        r2 = r if r2 is None else r2
        h = prof / 2.0
        r0 = [tmp.verts.new((r * cos(2 * pi * i / seg), r * sin(2 * pi * i / seg), -h))
              for i in range(seg)]
        r1 = [tmp.verts.new((r2 * cos(2 * pi * i / seg), r2 * sin(2 * pi * i / seg), h))
              for i in range(seg)]
        for i in range(seg):
            j = (i + 1) % seg
            tmp.faces.new((r0[i], r0[j], r1[j], r1[i]))
        tmp.faces.new(r0[::-1])
        tmp.faces.new(r1)
        bmesh.ops.recalc_face_normals(tmp, faces=tmp.faces[:])
        tmp.normal_update()
        if bisel > 0 and abs(r - r2) < 1e-6:
            ed = []
            for e in tmp.edges:
                nz = [abs(f.normal.z) for f in e.link_faces]
                if len(nz) == 2 and max(nz) > 0.99 and min(nz) < 0.5:
                    ed.append(e)
            self._bisel(tmp, ed, bisel, min(r, prof))
            tmp.normal_update()
        for f in tmp.faces:
            f.smooth = False
        self._merge(tmp, M_eixo(loc, d))

    # -- prisma extrudado a partir de um polígono 2D
    def prisma(self, pts, w0, w1, plano='XY', bisel=0.003):
        tmp = bmesh.new()

        def P(u, v, w):
            if plano == 'XY':
                return (u, v, w)
            if plano == 'XZ':
                return (u, w, v)
            return (w, u, v)  # 'YZ'

        a = [tmp.verts.new(P(u, v, w0)) for u, v in pts]
        b = [tmp.verts.new(P(u, v, w1)) for u, v in pts]
        n = len(pts)
        tmp.faces.new(a[::-1])
        tmp.faces.new(b)
        for i in range(n):
            j = (i + 1) % n
            tmp.faces.new((a[i], a[j], b[j], b[i]))
        bmesh.ops.recalc_face_normals(tmp, faces=tmp.faces[:])
        lim = abs(w1 - w0)
        self._bisel(tmp, tmp.edges[:], bisel, lim)
        self._merge(tmp, Matrix.Identity(4))

    # -- toro (mangueiras, argolas)
    def toro(self, R, r, loc, d=(0, 0, 1), maj=28, mi=8):
        maj, mi = 10, 4
        tmp = bmesh.new()
        vs = []
        for i in range(maj):
            a = 2 * pi * i / maj
            fila = []
            for j in range(mi):
                b = 2 * pi * j / mi
                rr = R + r * cos(b)
                fila.append(tmp.verts.new((rr * cos(a), rr * sin(a), r * sin(b))))
            vs.append(fila)
        for i in range(maj):
            for j in range(mi):
                i2, j2 = (i + 1) % maj, (j + 1) % mi
                f = tmp.faces.new((vs[i][j], vs[i2][j], vs[i2][j2], vs[i][j2]))
                f.smooth = False
        bmesh.ops.recalc_face_normals(tmp, faces=tmp.faces[:])
        self._merge(tmp, M_eixo(loc, d))

    # -- cilindro entre dois pontos
    def tubo(self, p1, p2, r, seg=12, r2=None):
        p1, p2 = Vector(p1), Vector(p2)
        d = p2 - p1
        if d.length < 1e-6:
            return
        self.cil(r, d.length, (p1 + p2) / 2, d, r2=r2, seg=seg, bisel=0)

    # -- barra retangular entre dois pontos (eixo X local ao longo da barra)
    def barra(self, p1, p2, wy, wz, bisel=0.003):
        p1, p2 = Vector(p1), Vector(p2)
        d = p2 - p1
        if d.length < 1e-6:
            return
        M = M_trans((p1 + p2) / 2) @ d.to_track_quat('X', 'Z').to_matrix().to_4x4()
        self.caixa((d.length, wy, wz), None, bisel, M)

    def malha(self):
        mesh = bpy.data.meshes.new(self.nome)
        self.bm.to_mesh(mesh)
        self.bm.free()
        return mesh

    def concluir(self, material=None):
        mesh = self.malha()
        mesh.materials.append(material or MAT)
        obj = bpy.data.objects.new(self.nome, mesh)
        self.col.objects.link(obj)
        return obj


# ----------------------------------------------------------------------------
# FUNÇÕES REUTILIZÁVEIS DE DETALHE
# ----------------------------------------------------------------------------
def base_ortho(eixo):
    a = Vector(eixo).normalized()
    ref = Vector((0, 0, 1)) if abs(a.z) < 0.9 else Vector((1, 0, 0))
    u = a.cross(ref).normalized()
    v = a.cross(u).normalized()
    return a, u, v


def anel_parafusos(centro, raio, n, eixo, r=0.006, h=0.006, fase=0.0):
    return
    a, u, v = base_ortho(eixo)
    c = Vector(centro)
    for i in range(n):
        t = fase + 2 * pi * i / n
        PAR.cil(r, h, c + (u * cos(t) + v * sin(t)) * raio, a, seg=6, bisel=0)


def parafusos_retangulo(centro, w, h, eixo, r=0.006, alt=0.006):
    return
    a, u, v = base_ortho(eixo)
    c = Vector(centro)
    for su in (-1, 1):
        for sv in (-1, 1):
            PAR.cil(r, alt, c + u * (su * w / 2) + v * (sv * h / 2), a, seg=6, bisel=0)


def lente(p, loc, r, d=(1, 0, 0), prof=0.03):
    """Módulo óptico: barril, anel frontal, vidro e núcleo."""
    a = Vector(d).normalized()
    loc = Vector(loc)
    p.cil(r, prof, loc - a * prof / 2, a, seg=28, bisel=0.002)
    p.cil(r * 0.8, 0.012, loc + a * 0.008, a, seg=28)


def cabo(p, pts, r, juntas=True, seg=10):
    if r < 0.0095:
        return   # PS1: cabos finos e alças pequenas eliminados
    juntas = False
    pts = [Vector(q) for q in pts]
    for a, b in zip(pts[:-1], pts[1:]):
        if (b - a).length > 1e-5:
            p.tubo(a, b, r, seg)
    if juntas:
        for i in range(1, len(pts) - 1):
            d = pts[i + 1] - pts[i - 1]
            if d.length > 1e-5:
                p.cil(r * 1.12, r * 2.4, pts[i], d, seg=seg, bisel=0)


def curva(p0, p1, p2, n=8):
    p0, p1, p2 = Vector(p0), Vector(p1), Vector(p2)
    out = []
    for i in range(n + 1):
        t = i / n
        out.append((1 - t) ** 2 * p0 + 2 * (1 - t) * t * p1 + t * t * p2)
    return out


def atuador(p, A, B, r_cil=0.02, r_haste=0.011, frac=0.55, eixo_pino=(0, 1, 0)):
    """Atuador hidráulico: cilindro + haste + colar + olhais de fixação."""
    A, B = Vector(A), Vector(B)
    M = A + (B - A) * frac
    p.tubo(A, M, r_cil, seg=16)
    p.tubo(M, B, r_haste, seg=12)
    d = (B - A).normalized()
    p.cil(r_cil * 0.9, r_cil * 3.0, A, eixo_pino, seg=14, bisel=0.002)
    p.cil(r_haste * 1.4, r_haste * 4.0, B, eixo_pino, seg=14, bisel=0.002)


def estadio(x1, x2, z, r, n=10):
    pts = []
    for i in range(n + 1):
        a = pi / 2 + pi * i / n
        pts.append((x1 + r * cos(a), z + r * sin(a)))
    for i in range(n + 1):
        a = -pi / 2 + pi * i / n
        pts.append((x2 + r * cos(a), z + r * sin(a)))
    return pts


