# ----------------------------------------------------------------------------
def construir_braco():
    p = Peca("Braco_Robotico", "BRACO_ROBOTICO")
    Y = -0.25
    BX = 0.30
    S = Vector((BX, Y, 0.74))
    E = Vector((BX + 0.10, Y, 1.12))
    W = Vector((BX + 0.62, Y, 1.20))
    YA = (0, 1, 0)

    # base rotativa
    p.cil(0.085, 0.03, (BX, Y, TOPO + 0.015), seg=32)
    p.cil(0.070, 0.04, (BX, Y, TOPO + 0.05), seg=32)
    anel_parafusos((BX, Y, TOPO + 0.03), 0.078, 10, (0, 0, 1), r=0.0055, h=0.006)
    p.cil(0.060, 0.05, (BX, Y, TOPO + 0.095), seg=28)
    p.caixa((0.14, 0.12, 0.10), (BX - 0.015, Y, 0.665), 0.006)

    # ombro: garfo, junta e tampas
    for s in (-1, 1):
        p.caixa((0.11, 0.028, 0.14), (BX, Y + s * 0.058, 0.725), 0.005)
        p.cil(0.048, 0.022, (BX, Y + s * 0.083, S.z), YA, seg=28, bisel=0.002)
        anel_parafusos((BX, Y + s * 0.096, S.z), 0.034, 6, (0, 1, 0), r=0.0045, h=0.004)
    p.cil(0.062, 0.090, S, YA, seg=32)
    p.cil(0.030, 0.140, S, YA, seg=20)

    # segmento principal (braço)
    p.barra(S, E, 0.072, 0.080, 0.005)
    for s in (-1, 1):
        p.barra(S + Vector((0.0, s * 0.040, 0.02)), E + Vector((0.0, s * 0.040, -0.02)), 0.012, 0.062, 0.003)
    # carenagem do braço
    pm = S + (E - S) * 0.5
    p.caixa((0.11, 0.09, 0.09), pm + Vector((0.0, 0.0, 0.0)), 0.006)
    parafusos_retangulo(pm + Vector((0, 0.046, 0)), 0.08, 0.07, (0, 1, 0), r=0.0045, alt=0.004)

    # cotovelo: disco grande externo (característico) e garfo
    for s in (-1, 1):
        p.caixa((0.12, 0.026, 0.14), (E.x, Y + s * 0.050, E.z), 0.005)
    p.cil(0.060, 0.090, E, YA, seg=32)
    p.cil(0.072, 0.024, (E.x, Y - 0.070, E.z), YA, seg=36, bisel=0.003)
    p.cil(0.050, 0.012, (E.x, Y - 0.088, E.z), YA, seg=32, bisel=0.002)
    anel_parafusos((E.x, Y - 0.096, E.z), 0.038, 8, (0, -1, 0), r=0.0045, h=0.004)
    p.cil(0.050, 0.020, (E.x, Y + 0.068, E.z), YA, seg=28, bisel=0.002)
    # mangueira em anel envolvendo o cotovelo
    p.toro(0.082, 0.0075, (E.x, Y + 0.095, E.z), YA)

    # segundo segmento (antebraço)
    p.barra(E, W, 0.066, 0.064, 0.005)
    for s in (-1, 1):
        p.barra(E + Vector((0.07, s * 0.038, 0.0)), W + Vector((-0.07, s * 0.038, 0.0)), 0.012, 0.050, 0.003)
    pf = E + (W - E) * 0.45
    p.caixa((0.12, 0.085, 0.085), pf, 0.006)
    parafusos_retangulo(pf + Vector((0, 0.044, 0)), 0.09, 0.065, (0, 1, 0), r=0.0045, alt=0.004)
    pf2 = E + (W - E) * 0.78
    p.caixa((0.08, 0.075, 0.075), pf2, 0.005)

    # punho
    Gx = W.x + 0.03
    for s in (-1, 1):
        p.cil(0.048, 0.020, (W.x, Y + s * 0.050, W.z), YA, seg=28, bisel=0.002)
    p.cil(0.045, 0.080, W, YA, seg=28)
    p.caixa((0.10, 0.085, 0.08), (Gx, Y, W.z - 0.012), 0.006)
    p.cil(0.040, 0.05, (Gx, Y, W.z - 0.065), seg=28)
    p.cil(0.052, 0.012, (Gx, Y, W.z - 0.095), seg=28, bisel=0.002)
    anel_parafusos((Gx, Y, W.z - 0.1015), 0.044, 8, (0, 0, -1), r=0.0045, h=0.004)

    # garra com duas pinças
    zf = W.z - 0.18
    p.caixa((0.10, 0.125, 0.08), (Gx, Y, W.z - 0.14), 0.006)
    p.caixa((0.07, 0.15, 0.03), (Gx, Y, zf + 0.020), 0.004)
    base = [(0.020, 0.0), (0.065, 0.0), (0.080, -0.060), (0.062, -0.140),
            (0.015, -0.200), (0.020, -0.130), (0.040, -0.070), (0.020, -0.040)]
    for s in (1, -1):
        pts = [(Y + s * dy, zf + dz) for dy, dz in base]
        p.prisma(pts, Gx - 0.020, Gx + 0.020, 'YZ', 0.0015)
        p.cil(0.013, 0.058, (Gx, Y + s * 0.050, zf - 0.012), (1, 0, 0), seg=14, bisel=0.002)
        atuador(p, (Gx + 0.0, Y + s * 0.088, W.z - 0.115), (Gx + 0.0, Y + s * 0.062, zf - 0.015),
                0.013, 0.007, 0.5, (1, 0, 0))
        # dentes de aderência na face interna
        for k in range(0):
            p.caixa((0.034, 0.008, 0.010), (Gx, Y + s * (0.032 + 0.0 * k), zf - 0.075 - k * 0.025), 0.001)

    # atuadores hidráulicos (olhais ligam suportes ao braço)
    yo = Y - 0.115
    A1 = Vector((BX - 0.10, yo, 0.665))
    B1 = S + (E - S) * 0.50 + Vector((0.0, yo - Y, 0.0)) + Vector((0.0, 0.0, 0.0))
    p.caixa((0.04, 0.050, 0.05), (BX - 0.10, Y - 0.085, 0.665), 0.004)
    p.caixa((0.05, 0.065, 0.05), (B1.x, Y - 0.070, B1.z), 0.004)
    atuador(p, A1, B1, 0.021, 0.012, 0.56)

    A2 = S + (E - S) * 0.86 + Vector((-0.045, yo - Y, 0.0))
    B2 = E + (W - E) * 0.40 + Vector((0.0, yo - Y, 0.065))
    p.caixa((0.04, 0.065, 0.04), (A2.x, Y - 0.075, A2.z), 0.004)
    p.caixa((0.04, 0.065, 0.04), (B2.x, Y - 0.075, B2.z - 0.02), 0.004)
    atuador(p, A2, B2, 0.019, 0.011, 0.50)
    p.concluir()

    # cabos e conexões do braço
    cabo(CAB, [(BX, Y + 0.03, TOPO + 0.12), (BX + 0.04, Y + 0.075, 0.80), (BX + 0.08, Y + 0.075, 1.06),
               (BX + 0.18, Y + 0.075, 1.12)], 0.008)
    cabo(CAB, curva((BX + 0.18, Y + 0.075, 1.12), (BX + 0.40, Y + 0.075, 1.19),
                    (W.x - 0.05, Y + 0.075, W.z - 0.03), 8), 0.008)
    cabo(CAB, curva((W.x - 0.05, Y + 0.075, W.z - 0.03), (W.x + 0.02, Y + 0.09, W.z - 0.08),
                    (Gx, Y + 0.05, W.z - 0.12), 6), 0.007)
    cabo(CAB, curva((BX + 0.02, Y - 0.04, 0.66), (BX + 0.10, Y - 0.12, 0.80), (BX + 0.12, Y - 0.095, 0.94), 6), 0.0055)


