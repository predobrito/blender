# CÂMERA, LUZES, CENÁRIO
# ----------------------------------------------------------------------------
def criar_estudio():
    sc = bpy.context.scene

    # chão de estúdio (cilindro baixo escuro)
    ch = Peca("Chao_Estudio", "DETALHES")
    ch.cil(3.6, 0.02, (0.0, 0.0, -0.01), seg=96, bisel=0)
    ch.concluir(MAT_CHAO)

    alvo = bpy.data.objects.new("Alvo_Camera", None)
    alvo.location = (0.05, 0.0, 0.78)
    sc.collection.objects.link(alvo)

    cd = bpy.data.cameras.new("Camera_Apresentacao")
    cd.lens = 48
    cd.clip_end = 100
    cam = bpy.data.objects.new("Camera_Apresentacao", cd)
    cam.location = (3.15, -2.75, 1.75)
    sc.collection.objects.link(cam)
    c = cam.constraints.new('TRACK_TO')
    c.target = alvo
    c.track_axis = 'TRACK_NEGATIVE_Z'
    c.up_axis = 'UP_Y'
    sc.camera = cam

    def luz(nome, loc, energia, tam, cor=(1, 1, 1)):
        d = bpy.data.lights.new(nome, 'AREA')
        d.energy = energia
        d.size = tam
        d.color = cor
        o = bpy.data.objects.new(nome, d)
        o.location = loc
        sc.collection.objects.link(o)
        t = o.constraints.new('TRACK_TO')
        t.target = alvo
        t.track_axis = 'TRACK_NEGATIVE_Z'
        t.up_axis = 'UP_Y'

    luz("Luz_Principal", (2.6, -2.2, 3.2), 700, 2.2)
    luz("Luz_Preenchimento", (-2.8, -2.4, 1.6), 260, 3.0, (0.92, 0.95, 1.0))
    luz("Luz_Contorno", (-1.2, 2.8, 2.6), 420, 1.6)
    luz("Luz_Topo", (0.0, 0.0, 4.0), 260, 3.0)

    # mundo escuro
    if sc.world is None:
        sc.world = bpy.data.worlds.new("Mundo_Estudio")
    sc.world.use_nodes = True
    bg = sc.world.node_tree.nodes.get("Background")
    if bg:
        bg.inputs[0].default_value = (0.035, 0.035, 0.04, 1)
        bg.inputs[1].default_value = 1.0

    # render
    sc.render.engine = 'CYCLES'
    sc.cycles.samples = 96
    sc.render.resolution_x = 1920
    sc.render.resolution_y = 1280
    sc.render.resolution_percentage = 100

    # mostrar a câmera no viewport
    try:
        for area in bpy.context.screen.areas:
            if area.type == 'VIEW_3D':
                area.spaces[0].region_3d.view_perspective = 'CAMERA'
    except Exception:
        pass


